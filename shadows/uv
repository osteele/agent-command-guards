#!/usr/bin/env python3
"""Shadow uv so local `uv run` commands inherit the agent RAM guard."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
BYPASS_VALUES = {"0", "false", "no", "off"}
# The guard is `with-limits` from crates.io (`cargo install with-limits`),
# found on PATH rather than beside this file: the Python guard that used to
# live here was retired once the crate covered its contract.
GUARD_NAME = "with-limits"
# Set by the guard in the environment of everything it runs. Checking it is
# what keeps the two entry points -- this shadow and the pre-tool hook -- from
# wrapping one command twice.
GUARD_ACTIVE_VARS = ("WITH_LIMITS_ACTIVE", "LLM_RAM_GUARD_ACTIVE")
GLOBAL_OPTIONS_WITH_VALUES = {
    "--allow-insecure-host",
    "--cache-dir",
    "--color",
    "--config-file",
    "--directory",
    "--project",
    "--python-preference",
}


def find_real_uv() -> str:
    """Find the next executable uv on PATH, excluding this wrapper."""
    wrapper = Path(__file__).resolve()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        candidate = Path(directory).expanduser() / "uv"
        try:
            resolved = candidate.resolve(strict=True)
        except OSError:
            continue
        if resolved == wrapper or not os.access(resolved, os.X_OK):
            continue
        # A mise shim may recurse or wait indefinitely when this shadow is ahead
        # of it on PATH. Continue to the concrete uv binary instead.
        if resolved.name == "mise":
            continue
        return str(candidate)
    raise RuntimeError("could not find the real uv binary after the shadow wrapper")


def guard_disabled() -> bool:
    value = os.environ.get("LLM_RAM_GUARD", "").strip().lower()
    return value in BYPASS_VALUES


def find_subcommand(args: list[str]) -> str | None:
    """Return uv's subcommand after any global options."""
    skip_next = False
    for arg in args:
        if skip_next:
            skip_next = False
            continue
        if arg in GLOBAL_OPTIONS_WITH_VALUES:
            skip_next = True
            continue
        if arg.startswith("-"):
            continue
        return arg
    return None


def guard_already_active() -> bool:
    return any(os.environ.get(name) == "1" for name in GUARD_ACTIVE_VARS)


def find_guard() -> str | None:
    """Locate the guard binary, ignoring this directory.

    A shadow directory that ever regains a `with-limits` entry would otherwise
    make the guard exec itself.
    """
    found = shutil.which(GUARD_NAME)
    if found is None:
        return None
    return None if Path(found).resolve().parent == HERE else found


def main() -> None:
    real_uv = find_real_uv()
    args = sys.argv[1:]
    should_guard = (
        find_subcommand(args) == "run"
        and not guard_disabled()
        and not guard_already_active()
    )
    if should_guard:
        guard = find_guard()
        if guard is None:
            # Never fall through quietly: an unguarded `uv run` is exactly the
            # failure this shadow exists to prevent, and it looks like success.
            print(
                f"uv shadow: {GUARD_NAME} is not on PATH, so this `uv run` is "
                "UNGUARDED. Install it with `cargo install with-limits`, or set "
                "LLM_RAM_GUARD=off to silence this.",
                file=sys.stderr,
            )
        else:
            os.execv(guard, [guard, "--", real_uv, *args])
    os.execv(real_uv, [real_uv, *args])


if __name__ == "__main__":
    main()
