#!/bin/bash
set -euo pipefail

SCRIPT_PATH="$(realpath "$0")"

find_real_binary() {
    local binary="$1"
    shift
    local skip_paths=("$@")
    local candidate real_candidate skip
    while IFS= read -r candidate; do
        real_candidate="$(realpath "$candidate" 2>/dev/null || true)"
        if [[ -z "$real_candidate" ]]; then
            continue
        fi
        skip=false
        for skip_path in "${skip_paths[@]}"; do
            if [[ -n "$skip_path" && "$real_candidate" == "$skip_path" ]]; then
                skip=true
                break
            fi
        done
        if [[ "$skip" == false ]]; then
            echo "$candidate"
            return 0
        fi
    done < <(which -a "$binary" 2>/dev/null)

    echo "Error: Could not find real $binary binary" >&2
    exit 1
}

REAL_GIT="$(find_real_binary git "$SCRIPT_PATH")"

GIT_SEARCH_DIR="$PWD"
SUBCMD=""
SUBCMD_INDEX=0
EXPLICIT_GIT_REPOSITORY=false
EXPLICIT_GIT_DIR="${GIT_DIR:-}"
EXPLICIT_WORK_TREE="${GIT_WORK_TREE:-}"
EXPLICIT_BARE=false
if [[ -n "${GIT_DIR:-}" || -n "${GIT_WORK_TREE:-}" ]]; then
    EXPLICIT_GIT_REPOSITORY=true
fi

update_git_search_dir() {
    local requested="$1"
    if [[ "$requested" == /* ]]; then
        GIT_SEARCH_DIR="$requested"
    else
        GIT_SEARCH_DIR="$GIT_SEARCH_DIR/$requested"
    fi
    if [[ -d "$GIT_SEARCH_DIR" ]]; then
        GIT_SEARCH_DIR="$(cd -- "$GIT_SEARCH_DIR" && pwd -P)"
    fi
}

parse_git_invocation() {
    local -a arguments=("$@")
    local index=0 arg
    while (( index < ${#arguments[@]} )); do
        arg="${arguments[$index]}"
        case "$arg" in
            -C)
                index=$((index + 1))
                if (( index >= ${#arguments[@]} )); then return; fi
                update_git_search_dir "${arguments[$index]}"
                ;;
            -C?*) update_git_search_dir "${arg:2}" ;;
            -c|--config-env|--namespace)
                index=$((index + 1))
                ;;
            --git-dir)
                EXPLICIT_GIT_REPOSITORY=true
                index=$((index + 1))
                if (( index < ${#arguments[@]} )); then
                    EXPLICIT_GIT_DIR="${arguments[$index]}"
                fi
                ;;
            --work-tree)
                EXPLICIT_GIT_REPOSITORY=true
                index=$((index + 1))
                if (( index < ${#arguments[@]} )); then
                    EXPLICIT_WORK_TREE="${arguments[$index]}"
                fi
                ;;
            --git-dir=*)
                EXPLICIT_GIT_REPOSITORY=true
                EXPLICIT_GIT_DIR="${arg#*=}"
                ;;
            --work-tree=*)
                EXPLICIT_GIT_REPOSITORY=true
                EXPLICIT_WORK_TREE="${arg#*=}"
                ;;
            --bare)
                EXPLICIT_GIT_REPOSITORY=true
                EXPLICIT_BARE=true
                ;;
            -c?*|--config-env=*|--namespace=*) ;;
            -*) ;;
            *)
                SUBCMD="$arg"
                SUBCMD_INDEX=$((index + 1))
                return
                ;;
        esac
        index=$((index + 1))
    done
}

parse_git_invocation "$@"
if (( SUBCMD_INDEX > 0 )); then
    SUBCMD_ARGS=("${@:$((SUBCMD_INDEX + 1))}")
else
    SUBCMD_ARGS=()
fi

warn_about_jj_compatibility() {
    local command="git"
    if [[ -n "$SUBCMD" ]]; then
        command+=" $SUBCMD"
    fi
    printf 'Warning: this repo is managed by jujutsu. `%s` is supported through a compatibility layer, but `git` commands in general are not supported; please use `jj` instead.\n' "$command" >&2
}

# Walk up from Git's effective working directory looking for a .jj directory.
find_jj_root() {
    local dir="${1:-$PWD}"
    dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
    while true; do
        if [[ -d "$dir/.jj" ]]; then
            echo "$dir"
            return 0
        fi
        if [[ "$dir" == "/" ]]; then
            break
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

resolve_explicit_git_path() {
    local path="$1"
    local candidate
    if [[ "$path" == /* ]]; then
        candidate="$path"
    else
        candidate="$GIT_SEARCH_DIR/$path"
    fi
    # Python's non-strict realpath resolves symlinks and `..` through the
    # nearest existing ancestor while preserving leaves that Git may create.
    python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$candidate"
}

find_jj_root_from_explicit_path() {
    local path="$1"
    local resolved root
    resolved="$(resolve_explicit_git_path "$path")" || return 1
    while [[ ! -d "$resolved" ]]; do
        if [[ "$resolved" == "/" ]]; then return 1; fi
        resolved="$(dirname "$resolved")"
    done
    root="$(find_jj_root "$resolved" 2>/dev/null)" || return 1
    if [[ -e "$root/.git" ]]; then
        echo "$root"
        return 0
    fi
    return 1
}

find_invocation_jj_root() {
    local root
    if [[ -n "$EXPLICIT_WORK_TREE" ]] && root="$(find_jj_root_from_explicit_path \
        "$EXPLICIT_WORK_TREE")"; then
        echo "$root"
        return 0
    fi
    if [[ -n "$EXPLICIT_GIT_DIR" ]] && root="$(find_jj_root_from_explicit_path \
        "$EXPLICIT_GIT_DIR")"; then
        echo "$root"
        return 0
    fi
    root="$(find_jj_root "$GIT_SEARCH_DIR" 2>/dev/null)" || return 1
    if [[ -e "$root/.git" ]]; then
        echo "$root"
        return 0
    fi
    return 1
}

path_is_within() {
    local path="$1"
    local root="$2"
    [[ "$path" == "$root" || "$path" == "$root/"* ]]
}

# An explicit repository bypasses the jj guard only when its Git directory and
# working tree are both known to be outside the surrounding jj repository.
# A lone external --git-dir is not enough: Git may still use the current jj
# working tree. Bare repositories have no working tree, so the Git directory is
# sufficient in that case.
explicit_repository_is_outside_jj() {
    local jj_root="$1"
    local resolved_jj_root resolved_git_dir resolved_work_tree

    if ! $EXPLICIT_GIT_REPOSITORY || [[ -z "$EXPLICIT_GIT_DIR" ]]; then
        return 1
    fi
    resolved_jj_root="$(realpath "$jj_root" 2>/dev/null)" || return 1
    resolved_git_dir="$(resolve_explicit_git_path "$EXPLICIT_GIT_DIR")" || return 1
    if path_is_within "$resolved_git_dir" "$resolved_jj_root"; then
        return 1
    fi
    if $EXPLICIT_BARE; then
        return 0
    fi
    if [[ -z "$EXPLICIT_WORK_TREE" ]]; then
        return 1
    fi
    resolved_work_tree="$(resolve_explicit_git_path "$EXPLICIT_WORK_TREE")" || return 1
    ! path_is_within "$resolved_work_tree" "$resolved_jj_root"
}

find_guarded_jj_root() {
    local root
    root="$(find_invocation_jj_root)" || return 1
    if explicit_repository_is_outside_jj "$root"; then
        return 1
    fi
    echo "$root"
}

get_jj_git_dir() {
    local jj_root="$1"
    if [[ -e "$jj_root/.git" ]]; then
        echo "$jj_root/.git"
        return 0
    fi
    return 1
}

# Any jj command snapshots a co-located working copy and synchronizes Git's
# HEAD and index. Status is read-only apart from that standard synchronization.
sync_jj_working_copy() {
    local jj_root="$1"
    jj -R "$jj_root" status >/dev/null 2>&1
}

retire_shadow_bookmarks() {
    local jj_root="$1"
    local bookmark
    for bookmark in local/jj-shadow-head jj-head; do
        if ! "$REAL_GIT" --git-dir="$jj_root/.git" show-ref --verify --quiet refs/heads/"$bookmark" 2>/dev/null; then
            continue
        fi
        # Deleting the Git ref directly would make jj import a bookmark
        # deletion. Let jj update both views atomically.
        jj -R "$jj_root" bookmark delete "$bookmark" >/dev/null 2>&1 || return 1
    done
}

branch_is_read_only() {
    local list_patterns=false arg
    while (( $# > 0 )); do
        arg="$1"
        shift
        case "$arg" in
            --list)
                list_patterns=true
                ;;
            -a|-r|-v|-vv|--all|--ignore-case|--no-abbrev|--no-color|--no-column|--omit-empty|--remotes|--show-current|--verbose)
                ;;
            --abbrev|--color|--column|--contains|--format|--merged|--no-contains|--no-merged|--points-at|--sort)
                # These options accept a separate value, but some also have a
                # useful value-less form. Consume a value only when present.
                if (( $# > 0 )) && [[ "$1" != -* ]]; then shift; fi
                ;;
            --abbrev=*|--color=*|--column=*|--contains=*|--format=*|--merged=*|--no-contains=*|--no-merged=*|--points-at=*|--sort=*)
                ;;
            --)
                $list_patterns || return 1
                return 0
                ;;
            -[arv]*)
                [[ "${arg:1}" =~ ^[arv]+$ ]] || return 1
                ;;
            -*)
                return 1
                ;;
            *)
                $list_patterns || return 1
                ;;
        esac
    done
    return 0
}

is_allowlisted_read_command() {
    case "$SUBCMD" in
        ""|annotate|blame|cat-file|check-attr|check-ignore|check-mailmap|diff|diff-files|diff-index|diff-tree|for-each-ref|grep|log|ls-files|ls-tree|merge-base|name-rev|range-diff|rev-list|rev-parse|shortlog|show|show-ref|status|version|whatchanged)
            return 0
            ;;
        branch)
            # macOS ships bash 3.2, where "${arr[@]}" on an empty array is an
            # unbound-variable error under `set -u`. Bare `git branch` has no
            # arguments and is read-only, so it must survive this call.
            branch_is_read_only ${SUBCMD_ARGS[@]+"${SUBCMD_ARGS[@]}"}
            return
            ;;
        *)
            return 1
            ;;
    esac
}

deny_unsupported_git_command() {
    local command="git"
    if [[ -n "$SUBCMD" ]]; then command+=" $SUBCMD"; fi
    printf 'git shadow: refusing unsupported `%s` in a jj repository; only explicitly allowlisted Git compatibility commands may run. Use `jj` instead.\n' "$command" >&2
    exit 1
}

# In jj repos, git add is a no-op (jj auto-tracks via snapshot.auto-track).
if [[ "$SUBCMD" == "add" ]]; then
    if find_guarded_jj_root &>/dev/null; then
        exit 0
    fi
fi

# In jj repos, translate git commit to jj commit / jj describe.
if [[ "$SUBCMD" == "commit" ]]; then
    if jj_root="$(find_guarded_jj_root)"; then
        local_args=()
        amend=false
        set -- ${SUBCMD_ARGS[@]+"${SUBCMD_ARGS[@]}"}
        while (( $# )); do
            arg="$1"
            shift
            case "$arg" in
                --amend) amend=true ;;
                -m|--message)
                    # Join the value so jj accepts messages beginning with "-".
                    if (( $# )); then
                        local_args+=("--message=$1")
                        shift
                    else
                        local_args+=("$arg")
                    fi
                    ;;
                -m=*|--message=*) local_args+=("$arg") ;;
                # Skip Git-only flags, but never reinterpret their message values.
                -a|--all|-p|--patch|--allow-empty|--no-edit) ;;
                --)
                    local_args+=("--" "$@")
                    break
                    ;;
                *) local_args+=("$arg") ;;
            esac
        done
        cd -- "$GIT_SEARCH_DIR"
        if $amend; then
            exec jj -R "$jj_root" describe ${local_args[@]+"${local_args[@]}"}
        else
            exec jj -R "$jj_root" commit ${local_args[@]+"${local_args[@]}"}
        fi
    fi
fi

# Map git worktree subcommands to jj workspace equivalents in jj repos.
handle_worktree() {
    local jj_root="$1"
    shift
    local worktree_subcmd="${1:-}"
    shift

    case "$worktree_subcmd" in
        add)
            # Parse: git worktree add [flags] <path> [<commit-ish>]
            # -b/-B <branch> and --detach don't have jj equivalents; we ignore them.
            # --name is rejected because Git and jj assign workspace names differently.
            local path="" commit="" skip_next=false
            for arg in "$@"; do
                if $skip_next; then skip_next=false; continue; fi
                case "$arg" in
                    --name|--name=*)
                        echo "git shadow: --name is not supported; workspace name is derived from path basename" >&2
                        exit 1
                        ;;
                    -b|-B|--reason) skip_next=true ;;
                    --lock|-f|--detach|--checkout|--no-checkout|--orphan|--guess-remote) ;;
                    -*) ;;
                    *)
                        if [[ -z "$path" ]]; then path="$arg"
                        else commit="$arg"; fi
                        ;;
                esac
            done
            if [[ -z "$path" ]]; then
                echo "git shadow: missing path for worktree add" >&2; exit 1
            fi
            cd -- "$GIT_SEARCH_DIR"
            if [[ -n "$commit" ]]; then
                exec jj -R "$jj_root" workspace add -r "$commit" "$path"
            else
                exec jj -R "$jj_root" workspace add "$path"
            fi
            ;;
        list)
            exec jj -R "$jj_root" workspace list
            ;;
        remove)
            local path="" force=false
            for arg in "$@"; do
                case "$arg" in
                    -f|--force) force=true ;;
                    -*)
                        echo "git shadow: unsupported worktree remove option: $arg" >&2
                        exit 1
                        ;;
                    *) path="$arg" ;;
                esac
            done
            if [[ -z "$path" ]]; then
                echo "git shadow: missing path for worktree remove" >&2; exit 1
            fi

            local candidate_path="$path"
            if [[ "$candidate_path" != /* ]]; then
                candidate_path="$GIT_SEARCH_DIR/$candidate_path"
            fi
            # Directory suffixes make -L follow a symlink instead of testing it.
            while [[ "$candidate_path" != "/" ]]; do
                case "$candidate_path" in
                    */) candidate_path="${candidate_path%/}" ;;
                    */.) candidate_path="${candidate_path%/.}" ;;
                    *) break ;;
                esac
            done
            candidate_path="${candidate_path:-/}"
            if [[ -L "$candidate_path" ]]; then
                echo "git shadow: refusing to remove a workspace through a symbolic link: $path" >&2
                exit 1
            fi
            local resolved_path
            resolved_path="$(cd -- "$candidate_path" 2>/dev/null && pwd -P)" || {
                echo "git shadow: worktree path is not an existing directory: $path" >&2
                exit 1
            }
            if [[ "$resolved_path" == *$'\n'* || "$resolved_path" == *$'\t'* ]]; then
                echo "git shadow: worktree paths containing tabs or newlines are unsupported" >&2
                exit 1
            fi

            local resolved_jj_root
            resolved_jj_root="$(cd -- "$jj_root" && pwd -P)"
            if [[ "$resolved_path" == "/" || "$resolved_path" == "$resolved_jj_root" ]]; then
                echo "git shadow: refusing to remove the primary workspace: $path" >&2
                exit 1
            fi
            local resolved_pwd
            resolved_pwd="$(pwd -P)"
            if [[ "$resolved_pwd" == "$resolved_path" || "$resolved_pwd" == "$resolved_path/"* ]]; then
                echo "git shadow: refusing to remove the current directory or its ancestor: $path" >&2
                exit 1
            fi

            local workspace_rows name="" recorded_name recorded_root canonical_root
            workspace_rows="$(jj -R "$jj_root" workspace list -T 'name ++ "\t" ++ root ++ "\n"')"
            while IFS=$'\t' read -r recorded_name recorded_root; do
                [[ -d "$recorded_root" ]] || continue
                canonical_root="$(cd -- "$recorded_root" && pwd -P)"
                if [[ "$canonical_root" == "$resolved_path" ]]; then
                    name="$recorded_name"
                    break
                fi
            done <<< "$workspace_rows"
            if [[ -z "$name" ]]; then
                echo "git shadow: path is not a registered jj workspace: $path" >&2
                exit 1
            fi

            if ! $force; then
                local changes
                changes="$(jj -R "$resolved_path" diff --summary)"
                if [[ -n "$changes" ]]; then
                    echo "git shadow: workspace has changes; use -f to remove it: $path" >&2
                    exit 1
                fi

                local removal_git_dir workspace_commit removal_index extra_files
                removal_git_dir="$(get_jj_git_dir "$jj_root")" || exit 1
                workspace_commit="$(jj -R "$resolved_path" log -r @ --no-graph -T commit_id)"
                removal_index="$removal_git_dir/agent-command-guards.index"
                GIT_INDEX_FILE="$removal_index" "$REAL_GIT" \
                    --git-dir="$removal_git_dir" read-tree "$workspace_commit"
                extra_files="$(
                    GIT_INDEX_FILE="$removal_index" "$REAL_GIT" \
                        --git-dir="$removal_git_dir" --work-tree="$resolved_path" \
                        ls-files --others --exclude-standard -- ':!.jj' ':!.jj/**'
                    GIT_INDEX_FILE="$removal_index" "$REAL_GIT" \
                        --git-dir="$removal_git_dir" --work-tree="$resolved_path" \
                        ls-files --others --ignored --exclude-standard -- \
                        ':!.jj' ':!.jj/**'
                )"
                if [[ -n "$extra_files" ]]; then
                    echo "git shadow: workspace has untracked or ignored files; use -f to remove it: $path" >&2
                    exit 1
                fi
            fi

            echo "git shadow: removing $resolved_path and forgetting jj workspace $name" >&2
            rm -rf -- "${resolved_path:?}"
            jj -R "$jj_root" workspace forget "$name"
            exit 0
            ;;
        prune)
            exec jj -R "$jj_root" workspace update-stale
            ;;
        *)
            return 1
            ;;
    esac
}

if [[ "$SUBCMD" == "worktree" ]]; then
    if jj_root="$(find_guarded_jj_root)"; then
        if handle_worktree "$jj_root" ${SUBCMD_ARGS[@]+"${SUBCMD_ARGS[@]}"}; then
            true  # handled via exec/exit inside handle_worktree
        fi
    fi
fi

# In a co-located jj repository, delegate only commands whose behavior is
# explicitly classified as read-only. Synchronize jj's shared working copy
# first so even safe Git queries do not observe stale HEAD or index state.
if jj_root="$(find_guarded_jj_root)"; then
    if is_allowlisted_read_command; then
        if ! sync_jj_working_copy "$jj_root" || ! retire_shadow_bookmarks "$jj_root"; then
            echo "git shadow: could not synchronize the jj working copy before running Git" >&2
            exit 1
        fi
        warn_about_jj_compatibility
        exec "$REAL_GIT" "$@"
    fi
    deny_unsupported_git_command
fi

# Outside co-located jj repositories, preserve normal Git behavior.
exec "$REAL_GIT" "$@"
