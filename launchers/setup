#!/bin/bash
#
# Install the agent launchers (kimi, opencode, codex) ahead of their real binaries.
#
# The launchers live in this directory rather than the repository root so that
# putting them on PATH does not also put the command shadows there. Only the
# agent launchers themselves become globally visible; ssh, scp, rsync, git, and
# uv stay shadowed inside agent sessions alone.

set -euo pipefail

LAUNCHER_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$LAUNCHER_DIR/.." && pwd)"
LAUNCHER_TARGET="$REPO_DIR/agent-launcher"
SHADOW_DIR="$REPO_DIR/shadows"
CONFIG_DIR="$HOME/.config/agent-launchers"
ENV_FILE="$CONFIG_DIR/env"
BIN_DIR="${AGENT_LAUNCHER_BIN_DIR:-$HOME/bin}"
BLOCK_START="# >>> agent-launchers initialize >>>"
BLOCK_END="# <<< agent-launchers initialize <<<"
AGENTS=(kimi opencode codex)

DRY_RUN=false
UNINSTALL=false

usage() {
    printf 'Usage: %s [--dry-run | --uninstall]\n' "$0"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true ;;
        --uninstall) UNINSTALL=true ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

remove_block() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    grep -qF "$BLOCK_START" "$file" || return 0
    if $DRY_RUN; then
        printf 'Would remove managed block from %s\n' "$file"
        return 0
    fi
    # Resolve first: these files are commonly symlinks into a dotfiles
    # repository, and in-place sed refuses to edit anything but a regular file.
    local target
    target="$(realpath "$file")"
    if $DRY_RUN; then
        printf 'Would remove managed block from %s\n' "$target"
        return 0
    fi
    # Edit through a sibling temporary file: `sed -i ''` is BSD-only syntax,
    # and GNU sed would read the empty suffix as the script.
    local temporary="${target}.agent-launchers.tmp"
    sed "/$BLOCK_START/,/$BLOCK_END/d" "$target" > "$temporary"
    mv "$temporary" "$target"
    printf 'Removed managed block from %s\n' "$target"
}

add_block() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    if grep -qF "$BLOCK_START" "$file"; then
        printf 'Already configured: %s\n' "$file"
        return 0
    fi
    if $DRY_RUN; then
        printf 'Would add managed block to %s\n' "$file"
        return 0
    fi
    printf '\n%s\n%s\n%s\n%s\n' \
        "$BLOCK_START" \
        '# !! Contents within this block are managed by agent-command-guards/launchers/setup !!' \
        ". \"\$HOME/.config/agent-launchers/env\"" \
        "$BLOCK_END" >> "$file"
    printf 'Configured: %s\n' "$file"
}

if $UNINSTALL; then
    remove_block "$HOME/.zshenv"
    remove_block "$HOME/.zshrc"
    remove_block "$HOME/.bashrc"
    if [[ -f "$ENV_FILE" ]]; then
        if $DRY_RUN; then
            printf 'Would remove %s\n' "$ENV_FILE"
        else
            rm "$ENV_FILE"
            printf 'Removed %s\n' "$ENV_FILE"
        fi
    fi
    for agent in "${AGENTS[@]}"; do
        link="$BIN_DIR/$agent"
        if [[ -L "$link" && "$(realpath "$link")" == "$LAUNCHER_TARGET" ]]; then
            if $DRY_RUN; then
                printf 'Would remove %s\n' "$link"
            else
                rm "$link"
                printf 'Removed %s\n' "$link"
            fi
        fi
    done
    exit 0
fi

for agent in "${AGENTS[@]}"; do
    if [[ ! -L "$LAUNCHER_DIR/$agent" ]]; then
        printf 'Error: %s/%s is missing\n' "$LAUNCHER_DIR" "$agent" >&2
        exit 1
    fi
done

if $DRY_RUN; then
    printf 'Would create %s and prepend %s to PATH\n' "$ENV_FILE" "$LAUNCHER_DIR"
else
    mkdir -p "$CONFIG_DIR"
    cat > "$ENV_FILE" <<EOF
# agent-launchers shell setup (managed by agent-command-guards/launchers/setup)
export PATH="$LAUNCHER_DIR:\$PATH"

# Restore the command guards to the front of PATH.
#
# A launcher puts the guards directory on PATH before starting its agent. Every
# agent that re-sources shell configuration for its shell tool then lets mise,
# pixi, and friends prepend themselves ahead of it, and the guards stop winning
# the lookup while still appearing in PATH. Sourcing this file at the end of the
# rc files puts them back in front.
#
# The guards directory is only on PATH inside an agent session, so this is a
# no-op in an ordinary shell.
agent_guards_restore() {
    guards_dir="\${AGENT_COMMAND_GUARDS_DIR:-$SHADOW_DIR}"
    case ":\$PATH:" in
        *":\$guards_dir:"*) ;;
        *) unset guards_dir; return 0 ;;
    esac

    # Walk PATH with parameter expansion rather than word splitting: zsh does
    # not split unquoted variables, and these rc files run under zsh as well
    # as sh and bash.
    guards_rest="\$guards_dir"
    guards_rem="\$PATH"
    while [ -n "\$guards_rem" ]; do
        guards_entry="\${guards_rem%%:*}"
        if [ "\$guards_rem" = "\$guards_entry" ]; then
            guards_rem=""
        else
            guards_rem="\${guards_rem#*:}"
        fi
        if [ -n "\$guards_entry" ] && [ "\$guards_entry" != "\$guards_dir" ]; then
            guards_rest="\$guards_rest:\$guards_entry"
        fi
    done

    PATH="\$guards_rest"
    export PATH
    unset guards_dir guards_rest guards_rem guards_entry
}
agent_guards_restore
unset -f agent_guards_restore
EOF
    printf 'Generated %s\n' "$ENV_FILE"
    mkdir -p "$BIN_DIR"
fi

for agent in "${AGENTS[@]}"; do
    link="$BIN_DIR/$agent"
    if $DRY_RUN; then
        printf 'Would link %s to %s/%s\n' "$link" "$LAUNCHER_DIR" "$agent"
        continue
    fi
    if [[ -e "$link" || -L "$link" ]]; then
        if [[ ! -L "$link" || "$(realpath "$link")" != "$LAUNCHER_TARGET" ]]; then
            printf 'Error: Refusing to replace existing %s\n' "$link" >&2
            exit 1
        fi
        printf 'Already linked: %s\n' "$link"
    else
        ln -s "$LAUNCHER_DIR/$agent" "$link"
        printf 'Linked %s -> %s/%s\n' "$link" "$LAUNCHER_DIR" "$agent"
    fi
done

# .zshenv puts the launchers on PATH early. .zshrc and .bashrc run afterwards and
# let other version managers prepend themselves, so the block runs there too, last.
add_block "$HOME/.zshenv"
add_block "$HOME/.zshrc"
add_block "$HOME/.bashrc"

if ! $DRY_RUN; then
    printf 'Setup complete. Restart the shell or run: . %s\n' "$ENV_FILE"
    printf 'Then verify with: kimi wrapper doctor && opencode wrapper doctor\n'
fi
