#!/usr/bin/env python3
"""Resolve model-first interactive commands to guarded agent harnesses."""

from __future__ import annotations

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from collections.abc import Iterable
from datetime import datetime
from pathlib import Path
from typing import NamedTuple


# Shipped defaults. Kept out of the launcher directories, which are PATH
# entries where every file becomes a command name.
DEFAULTS_PATH = Path(__file__).resolve().parent.parent / "agent-models.toml"

# How each harness spells the fields a route may carry. A flag ending in "="
# joins its value; anything else passes the value as the following argument.
# Flag spellings are the harness's API, not a preference, so they stay here
# while the model names they carry live in the defaults file.
HARNESS_FLAGS: dict[str, dict[str, str]] = {
    "claude": {"model": "--model"},
    "codex": {},
    "kimi": {"model": "-m"},
    "opencode": {"model": "-m"},
    "omp": {"model": "--model="},
}

# The model-first commands expose one resume spelling. Each harness receives
# the spelling from its own CLI instead.
HARNESS_RESUME_ARGUMENTS: dict[str, tuple[str, ...]] = {
    "claude": ("--resume",),
    "codex": ("resume",),
    "kimi": ("--session",),
    "opencode": ("--session",),
    "omp": ("--resume",),
    "agy": ("--conversation",),
}
# The shapes an agent resolves itself. Anything else named to --resume is a
# session *name* or transcript text, resolved to one of these before exec.
_UUID = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
NATIVE_ID_PATTERN = re.compile(rf"(?:session_)?{_UUID}|ses_[A-Za-z0-9]{{10,}}")

# agent-mail's durable store of generated session names, keyed by a hash of the
# session id: {"sessionId", "assignedAt", "slug", "displayName"}. Read directly
# because agent-mail's CLI resolves a name only for a *live* session, and a
# session worth resuming has usually exited. Absent, unreadable, and malformed
# records are all "no match" rather than an error.
SESSION_NAMES_DIR = Path.home() / ".claude" / "agent-mail" / "session-names"

# Rendered in this order, so an invocation does not depend on file key order.
ROUTE_FIELDS = ("model",)


class ConfigError(ValueError):
    """The configuration is malformed or unsupported."""


class Command(NamedTuple):
    """One model-first command: its harnesses and which of them to use."""

    home: str
    default: str
    routes: dict[str, tuple[str, ...]]


def config_path() -> Path:
    root = os.environ.get("XDG_CONFIG_HOME")
    config_root = Path(root).expanduser() if root else Path.home() / ".config"
    return config_root / "agent-models" / "config.toml"


def _load_toml(path: Path) -> dict[str, object]:
    try:
        content = path.read_bytes()
    except OSError as error:
        raise ConfigError(f"{path}: cannot read: {error}") from error
    try:
        return tomllib.loads(content.decode())
    except UnicodeDecodeError as error:
        raise ConfigError(f"{path}: not UTF-8: {error}") from error
    except tomllib.TOMLDecodeError as error:
        raise ConfigError(f"{path}: invalid TOML: {error}") from error


def _table(value: object, location: str) -> dict[str, object]:
    if not isinstance(value, dict):
        raise ConfigError(f"{location}: expected a table")
    return value


def _string(value: object, location: str) -> str:
    if not isinstance(value, str) or not value:
        raise ConfigError(f"{location}: expected a non-empty string")
    return value


def _check_version(raw: dict[str, object], location: str) -> None:
    if raw.get("version") != 1:
        raise ConfigError(f"{location}: expected version = 1")


def render_route(harness: str, fields: dict[str, object], location: str) -> tuple[str, ...]:
    accepted = HARNESS_FLAGS[harness]
    for key in fields:
        if key not in accepted:
            expected = ", ".join(sorted(accepted)) or "no fields"
            raise ConfigError(f"{location}.{key}: {harness} accepts {expected}")
    invocation = [harness]
    for key in ROUTE_FIELDS:
        if key not in fields:
            continue
        value = _string(fields[key], f"{location}.{key}")
        flag = accepted[key]
        if flag.endswith("="):
            invocation.append(f"{flag}{value}")
        else:
            invocation.extend((flag, value))
    return tuple(invocation)


def read_commands(path: Path | None = None) -> dict[str, Command]:
    selected_path = path or DEFAULTS_PATH
    raw = _load_toml(selected_path)
    _check_version(raw, str(selected_path))
    unknown = set(raw) - {"version", "commands"}
    if unknown:
        raise ConfigError(f"{selected_path}: unknown key {sorted(unknown)[0]!r}")
    table = _table(raw.get("commands", {}), f"{selected_path}: commands")
    if not table:
        raise ConfigError(f"{selected_path}: commands is empty")

    commands: dict[str, Command] = {}
    for name, entry in table.items():
        location = f"{selected_path}: commands.{name}"
        fields = _table(entry, location)
        unknown = set(fields) - {"home", "default", "routes"}
        if unknown:
            raise ConfigError(f"{location}: unknown key {sorted(unknown)[0]!r}")
        route_table = _table(fields.get("routes", {}), f"{location}.routes")
        if not route_table:
            raise ConfigError(f"{location}.routes: expected at least one harness")
        routes: dict[str, tuple[str, ...]] = {}
        for harness, route_fields in route_table.items():
            route_location = f"{location}.routes.{harness}"
            if harness not in HARNESS_FLAGS:
                expected = ", ".join(sorted(HARNESS_FLAGS))
                raise ConfigError(f"{route_location}: unknown harness; expected {expected}")
            routes[harness] = render_route(
                harness, _table(route_fields, route_location), route_location
            )
        command = Command(
            home=_string(fields.get("home"), f"{location}.home"),
            default=_string(fields.get("default"), f"{location}.default"),
            routes=routes,
        )
        for key in ("home", "default"):
            harness = getattr(command, key)
            if harness not in routes:
                expected = ", ".join(sorted(routes))
                raise ConfigError(
                    f"{location}.{key}: {harness!r} has no route; expected {expected}"
                )
        commands[name] = command
    return commands


def known_harnesses(commands: dict[str, Command]) -> set[str]:
    return {harness for command in commands.values() for harness in command.routes}


def _canonical_harness(
    commands: dict[str, Command], model: str, harness: str, location: str,
    *, require_route: bool = True,
) -> str:
    command = commands[model]
    if harness in {"own", "self", "."}:
        return command.home
    if harness not in known_harnesses(commands):
        aliases = {"own", "self", "."}
        expected = ", ".join(sorted(known_harnesses(commands) | aliases))
        raise ConfigError(f"{location}: unknown harness {harness!r}; expected {expected}")
    if require_route and harness not in command.routes:
        expected = ", ".join(sorted(command.routes))
        raise ConfigError(
            f"{location}: {model} does not support harness {harness!r}; "
            f"expected {expected}, own, self, or ."
        )
    return harness


def read_config(commands: dict[str, Command], path: Path | None = None) -> dict[str, str]:
    selected_path = path or config_path()
    if not selected_path.exists():
        return {}
    raw = _load_toml(selected_path)
    _check_version(raw, str(selected_path))
    unknown = set(raw) - {"version", "defaults"}
    if unknown:
        raise ConfigError(f"{selected_path}: unknown key {sorted(unknown)[0]!r}")

    defaults: dict[str, str] = {}
    table = _table(raw.get("defaults", {}), f"{selected_path}: defaults")
    for model, value in table.items():
        location = f"{selected_path}: defaults.{model}"
        if model not in commands:
            raise ConfigError(f"{location}: unknown model {model!r}")
        harness = _string(value, location)
        defaults[model] = _canonical_harness(commands, model, harness, location)
    return defaults


def write_config(
    commands: dict[str, Command], defaults: dict[str, str], path: Path | None = None
) -> None:
    selected_path = path or config_path()
    selected_path.parent.mkdir(parents=True, exist_ok=True)
    content = ["version = 1", "", "[defaults]"]
    content.extend(f'{model} = "{defaults[model]}"' for model in commands if model in defaults)
    content.append("")
    temporary_name: str | None = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", dir=selected_path.parent, prefix=".config.toml.", delete=False
        ) as temporary:
            temporary.write("\n".join(content))
            temporary_name = temporary.name
        os.replace(temporary_name, selected_path)
    finally:
        if temporary_name is not None:
            try:
                Path(temporary_name).unlink()
            except FileNotFoundError:
                pass


def defaults_with_sources(commands: dict[str, Command]) -> dict[str, tuple[str, str]]:
    configured = read_config(commands)
    return {
        model: (
            configured.get(model, command.default),
            "config" if model in configured else "shipped",
        )
        for model, command in commands.items()
    }


def parse_harness_option(
    commands: dict[str, Command], model: str, arguments: list[str]
) -> tuple[str | None, list[str]]:
    if not arguments:
        return None, arguments
    first = arguments[0]
    if first == "--harness":
        if len(arguments) == 1:
            raise ConfigError("--harness requires a harness name")
        return _canonical_harness(commands, model, arguments[1], "--harness", require_route=False), arguments[2:]
    if first.startswith("--harness="):
        harness = first.partition("=")[2]
        if not harness:
            raise ConfigError("--harness requires a harness name")
        return _canonical_harness(commands, model, harness, "--harness", require_route=False), arguments[1:]
    if first == "-h" and len(arguments) > 1:
        candidate = arguments[1]
        aliases = {"own", "self", "."}
        if candidate in known_harnesses(commands) or candidate in aliases:
            return _canonical_harness(commands, model, candidate, "-h", require_route=False), arguments[2:]
    return None, arguments


def parse_resume_option(
    arguments: list[str],
) -> tuple[bool, str | None, list[str]]:
    """Remove one launcher-level --resume option and return its session id."""
    for index, argument in enumerate(arguments):
        if argument == "--":
            break
        if argument == "--resume":
            if index + 1 < len(arguments) and not arguments[index + 1].startswith("-"):
                return (
                    True,
                    arguments[index + 1],
                    arguments[:index] + arguments[index + 2 :],
                )
            return True, None, arguments[:index] + arguments[index + 1 :]
        if argument.startswith("--resume="):
            session_id = argument.partition("=")[2] or None
            return True, session_id, arguments[:index] + arguments[index + 1 :]
    return False, None, arguments


def normalize_resume_id(session_id: str) -> tuple[str, str | None]:
    """Convert an AgentsView canonical id to the harness's native id."""
    if session_id.startswith("antigravity-cli:"):
        return session_id.removeprefix("antigravity-cli:"), "agy"
    for harness in HARNESS_RESUME_ARGUMENTS:
        prefix = f"{harness}:"
        if not session_id.startswith(prefix):
            continue
        native_id = session_id.rsplit(":", 1)[-1] if harness == "kimi" else session_id[len(prefix) :]
        return native_id, harness
    return session_id, None


def _agentsview_query(
    arguments: list[str], timeout: float = 10.0
) -> tuple[object | None, bool]:
    """The parsed JSON, and whether AgentsView actually answered.

    Callers that treat a missing record as evidence need the second value: an
    uninstalled, hung, or erroring AgentsView returns no record either, and
    reading that as "this session does not exist" turns an outage into a
    confident wrong answer.
    """
    agentsview = shutil.which("agentsview")
    if agentsview is None:
        return None, False
    try:
        result = subprocess.run(
            [agentsview, *arguments, "--json"],
            capture_output=True,
            check=False,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f"agent-model: AgentsView lookup failed: {error}", file=sys.stderr)
        return None, False
    if result.returncode != 0:
        # Only a session-not-found diagnostic is authoritative, not e.g. a
        # missing config file or executable reported by the indexing service.
        missing = re.search(r"\bsession\b[^\n]*\bnot found\b", result.stderr, re.IGNORECASE)
        return None, arguments[:2] == ["session", "get"] and missing is not None
    try:
        return json.loads(result.stdout), True
    except json.JSONDecodeError as error:
        print(f"agent-model: AgentsView returned invalid JSON: {error}", file=sys.stderr)
        return None, False


def metadata_match(
    metadata: object, session_id: str, recency: str = ""
) -> SessionMatch | None:
    """Accept only metadata that explicitly identifies this exact conversation."""
    if not isinstance(metadata, dict):
        return None
    canonical, agent = metadata.get("id"), metadata.get("agent")
    if agent == "antigravity-cli":
        agent = "agy"
    if not isinstance(canonical, str) or not isinstance(agent, str) or agent not in HARNESS_RESUME_ARGUMENTS:
        return None
    native_id, prefix = normalize_resume_id(canonical)
    if native_id != session_id or (prefix is not None and prefix != agent):
        return None
    return SessionMatch(native_id, agent, recency, f"{agent}:{native_id}")


class SessionMatch(NamedTuple):
    """One session a --resume argument could name."""

    session_id: str
    harness: str
    recency: str
    label: str


# Session ids naming the session this process is running inside. Resuming the
# session you are typing in is never the intent, and a phrase the user has just
# typed is in that session's transcript, so search finds it.
CURRENT_SESSION_VARIABLES = (
    "AGENT_SESSION_ID",
    "CLAUDE_CODE_SESSION_ID",
    "CODEX_THREAD_ID",
)


def current_session_ids() -> set[str]:
    ids = set()
    for variable in CURRENT_SESSION_VARIABLES:
        value = os.environ.get(variable, "").strip()
        if value:
            ids.add(normalize_resume_id(value)[0])
    return ids


def _name_matches(query: str, slug: str, display_name: str) -> bool:
    """Whether `query` names this session.

    Accepts what the surfaces show: the display name ("Efficient Deer"), the
    slug ("efficient-deer"), and the project-qualified full name agent-mail
    addresses sessions by ("augur-efficient-deer").
    """
    normalized = query.casefold()
    if normalized in (display_name.casefold(), slug.casefold()):
        return True
    return bool(slug) and normalized.endswith(f"-{slug.casefold()}")


def _name_prefilter(query: str) -> bytes:
    """The one token every accepted spelling of a name must contain.

    A generated name ends in its noun, whether it arrives as "Efficient Deer",
    "efficient-deer", or "augur-efficient-deer". Requiring that word of the raw
    bytes skips the decode and JSON parse for all but a handful of records, and
    the store holds one per session ever named -- 3700 of them on this machine,
    where decoding every record costs four times reading them all.
    """
    tokens = re.findall(r"[0-9A-Za-z]+", query.casefold())
    return tokens[-1].encode("ascii") if tokens else b""


def sessions_named(query: str, directory: Path = SESSION_NAMES_DIR) -> list[SessionMatch]:
    """Sessions whose agent-mail name is `query`, most recently named first."""
    try:
        entries = sorted(directory.iterdir())
    except OSError:
        return []
    prefilter = _name_prefilter(query)
    matches: list[SessionMatch] = []
    unreadable = 0
    for entry in entries:
        if entry.suffix != ".json":
            continue
        try:
            content = entry.read_bytes()
        except OSError:
            unreadable += 1
            continue
        if prefilter and prefilter not in content.lower():
            continue
        try:
            record = json.loads(content)
        except (UnicodeDecodeError, json.JSONDecodeError):
            unreadable += 1
            continue
        if not isinstance(record, dict):
            unreadable += 1
            continue
        session_id = record.get("sessionId")
        slug = record.get("slug")
        display_name = record.get("displayName")
        if not isinstance(session_id, str) or not isinstance(slug, str):
            unreadable += 1
            continue
        if not isinstance(display_name, str):
            display_name = slug
        if not _name_matches(query, slug, display_name):
            continue
        assigned = record.get("assignedAt")
        matches.append(
            SessionMatch(
                session_id=session_id,
                harness="",
                recency=assigned if isinstance(assigned, str) else "",
                label=session_id,
            )
        )
    if unreadable and not matches:
        print(
            f"agent-model: skipped {unreadable} unreadable session-name "
            f"records under {directory}",
            file=sys.stderr,
        )
    return _ranked(matches)


def sessions_containing(query: str) -> Resolution:
    """Search message text, never tool arguments/results or a harness-only index."""
    payload, answered = _agentsview_query(
        ["session", "search", query, "--fts", "--limit", "50"], timeout=10.0
    )
    if not isinstance(payload, dict) or not isinstance(payload.get("matches"), list):
        return Resolution([], False)
    matches = []
    valid = answered
    for entry in payload["matches"]:
        if not isinstance(entry, dict) or not isinstance(entry.get("session_id"), str):
            valid = False
            continue
        native_id, harness = normalize_resume_id(entry["session_id"])
        agent = entry.get("agent")
        if agent == "antigravity-cli":
            agent = "agy"
        if (
            harness is None
            or not NATIVE_ID_PATTERN.fullmatch(native_id)
            or (agent is not None and agent != harness)
        ):
            valid = False
            continue
        timestamp = entry.get("timestamp")
        matches.append(SessionMatch(
            native_id, harness, timestamp if isinstance(timestamp, str) else "",
            f"{harness}:{native_id}",
        ))
    return Resolution(_ranked(matches), valid)


CLAUDE_PROJECTS_DIR = Path.home() / ".claude" / "projects"

# Where each harness keeps the transcripts it can reopen, as a glob over the
# session id. The file *is* the resumability test: a resume opens the transcript
# named after the id, so a hit proves the id opens something and names the
# harness that owns it -- both of the answers AgentsView is otherwise asked for,
# for the cost of a readdir.
#
# Ask the filesystem first because an indexed miss can be slow. An absent file
# is not proof of absence; only an exact filename verifies identity locally.
#
# The layouts are another tool's, and this repository cannot prove them; each was
# read off this machine's stores on 2026-09-18. A pattern that goes wrong when
# one of them changes costs a lookup rather than an answer: it degrades to the
# AgentsView path that ran before, because a hit still requires the id to appear
# in that harness's own store.
LOCAL_SESSION_STORES: dict[str, tuple[Path, str]] = {
    "claude": (CLAUDE_PROJECTS_DIR, "*/{session_id}.jsonl"),
    "omp": (Path.home() / ".omp" / "agent" / "sessions", "*/*_{session_id}.jsonl"),
    "codex": (Path.home() / ".codex" / "sessions", "*/*/*/rollout-*-{session_id}.jsonl"),
}


def local_store_harness(
    session_id: str, stores: dict[str, tuple[Path, str]] | None = None
) -> str | None:
    """The unique harness whose own session store holds this exact native id."""
    if not NATIVE_ID_PATTERN.fullmatch(session_id):
        return None
    owners = []
    for harness, (directory, pattern) in (stores or LOCAL_SESSION_STORES).items():
        try:
            if any(path.is_file() for path in directory.glob(pattern.format(session_id=session_id))):
                owners.append(harness)
        except OSError:
            continue
    return owners[0] if len(owners) == 1 else None


def _timestamp(value: object) -> float | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _ranked(matches: Iterable[SessionMatch]) -> list[SessionMatch]:
    """Deduplicate exact conversations and rank by timestamp, newest first."""
    current = current_session_ids()
    unique: dict[tuple[str, str], SessionMatch] = {}
    for match in matches:
        if match.session_id in current:
            continue
        key = (match.harness, match.session_id)
        previous = unique.get(key)
        if previous is None or (_timestamp(match.recency) or 0) > (_timestamp(previous.recency) or 0):
            unique[key] = match
    return sorted(
        unique.values(),
        key=lambda match: (_timestamp(match.recency) or 0, match.harness, match.session_id),
        reverse=True,
    )


class Resolution(NamedTuple):
    matches: list[SessionMatch]
    conclusive: bool


def exact_session(query: str) -> Resolution:
    """Positive local evidence first, then one exact supported CLI lookup."""
    native_id, _ = normalize_resume_id(query)
    if not NATIVE_ID_PATTERN.fullmatch(native_id):
        return Resolution([], False)
    harness = local_store_harness(native_id)
    if harness is not None:
        return Resolution([SessionMatch(native_id, harness, "", f"{harness}:{native_id}")], True)
    record, answered = _agentsview_query(["session", "get", native_id])
    match = metadata_match(record, native_id)
    if match is not None:
        return Resolution([match], True)
    # Null/not-found is an answer; a malformed or mismatched record is not.
    return Resolution([], answered and record is None)


def resolve_resume_target(query: str) -> Resolution:
    """Exact id, durable name, then message text, without heuristic identity joins."""
    if not query.strip():
        raise ConfigError("resume query must not be empty")
    native_id, _ = normalize_resume_id(query)
    if NATIVE_ID_PATTERN.fullmatch(native_id):
        if native_id in current_session_ids():
            return Resolution([], True)
        resolution = exact_session(query)
        return Resolution(_ranked(resolution.matches), resolution.conclusive)
    named = sessions_named(query)
    if named:
        matches = []
        conclusive = True
        for candidate in named:
            resolution = exact_session(candidate.session_id)
            conclusive = conclusive and resolution.conclusive
            matches.extend(
                match._replace(recency=candidate.recency) for match in resolution.matches
            )
        # A known name never falls through to an unrelated transcript mentioning it.
        return Resolution(_ranked(matches), conclusive)
    return sessions_containing(query)


def interactive_invocation(harness: str, arguments: list[str]) -> bool:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    return not headless_invocation(harness, arguments)


def argument_takes_value(harness: str, argument: str) -> bool:
    """Native option values cannot be interpreted as resume or execution modes."""
    if argument in {
        "--model", "-m", "--provider", "--config", "-c", "--profile", "--cd", "-C",
        "--resume", "-r", "--session", "-s", "-S", "--conversation", "--mode",
    }:
        return True
    return harness == "codex" and argument in {
        "-p", "-i", "--image", "--enable", "--disable", "--remote",
        "--remote-auth-token-env", "--local-provider", "--sandbox", "--add-dir",
        "-a", "--ask-for-approval", "--output-schema", "--output-last-message", "-o",
    }


def headless_invocation(harness: str, arguments: list[str]) -> bool:
    skip_value = False
    mode_value = False
    for argument in arguments:
        if skip_value:
            if mode_value and argument in {"json", "rpc"}:
                return True
            skip_value = mode_value = False
            continue
        if argument == "--":
            break
        if argument in {"--help", "-h", "--version", "-V"}:
            return True
        if harness == "omp" and argument in {"--mode=json", "--mode=rpc"}:
            return True
        if argument_takes_value(harness, argument):
            skip_value = True
            mode_value = harness == "omp" and argument == "--mode"
            continue
        if harness == "codex" and not argument.startswith("-"):
            return argument in {
                "exec", "e", "review", "login", "logout", "mcp", "plugin",
                "app-server", "remote-control", "app", "completion", "update",
                "doctor", "sandbox", "debug", "apply", "a", "queue", "archive",
                "delete", "migrate-rollouts", "unarchive", "cloud", "exec-server",
                "features", "help",
            }
        if harness == "opencode" and not argument.startswith("-"):
            return argument == "run"
        if harness in {"omp", "kimi", "agy", "claude"} and (
            argument in {"-p", "--print"} or argument.startswith("--print=")
        ):
            return True
    return False


def prompt_choice(title: str, choices: list[str], cancelled: str) -> int:
    print(f"agent-model: {title}", file=sys.stderr)
    for index, choice in enumerate(choices, 1):
        print(f"  {index}) {choice}", file=sys.stderr)
    while True:
        print("Choose a number, or q to cancel: ", end="", file=sys.stderr, flush=True)
        try:
            answer = sys.stdin.readline().strip()
        except KeyboardInterrupt:
            raise ConfigError(cancelled) from None
        if not answer or answer.casefold() in {"q", "cancel"}:
            raise ConfigError(cancelled)
        if answer.isdecimal() and 1 <= int(answer) <= len(choices):
            return int(answer) - 1
        print("Invalid selection.", file=sys.stderr)


def select_resume(
    query: str, requested: str | None, invocation: str, interactive: bool
) -> SessionMatch:
    resolution = resolve_resume_target(query)
    matches = resolution.matches
    if not matches:
        native_id, _ = normalize_resume_id(query)
        if not resolution.conclusive and NATIVE_ID_PATTERN.fullmatch(native_id):
            print("agent-model: Lookup unavailable; attempting exact native ID without verified ownership", file=sys.stderr)
            return SessionMatch(native_id, invocation, "", native_id)
        reason = "No matching conversation" if resolution.conclusive else "Lookup unavailable"
        raise ConfigError(f"{reason}: {query!r}")
    return select_matches(matches, query, requested, interactive)


def select_matches(
    matches: list[SessionMatch], query: str, requested: str | None, interactive: bool
) -> SessionMatch:
    preferred = [match for match in matches if match.harness == requested]
    if interactive and preferred and matches[0].harness != requested:
        selected = prompt_choice(
            f"A newer conversation belongs to another harness (requested {requested})",
            [match.label for match in matches], "Selection cancelled",
        )
        return matches[selected]
    chosen = preferred[0] if preferred else matches[0]
    alternatives = [match.label for match in matches if match != chosen]
    if alternatives:
        print(
            f"agent-model: {len(matches)} sessions match {query!r}; resuming "
            f"{chosen.label}. Others: {', '.join(alternatives)}. "
            "Pass a session id to select one.", file=sys.stderr,
        )
    return chosen


def resume_model_route(
    commands: dict[str, Command], model: str, harness: str,
    invocation_harness: str, interactive: bool,
) -> list[str]:
    command = commands.get(model)
    if command is not None and harness in command.routes:
        return list(command.routes[harness])
    reason = f"Requested model {model!r} has no route on the resume harness {harness!r}"
    if harness != invocation_harness and interactive:
        compatible = [name for name, configured in commands.items() if harness in configured.routes]
        if compatible:
            selected = prompt_choice(reason, compatible, "Model selection cancelled")
            return list(commands[compatible[selected]].routes[harness])
    raise ConfigError(reason)


def resume_arguments(harness: str, session_id: str | None) -> list[str]:
    arguments = list(HARNESS_RESUME_ARGUMENTS[harness])
    if session_id is not None:
        arguments.append(session_id)
    return arguments


def resolve(
    commands: dict[str, Command], model: str, arguments: list[str]
) -> tuple[list[str], str]:
    if model not in commands:
        raise ConfigError(f"unknown model {model!r}; expected {', '.join(commands)}")
    explicit, forwarded = parse_harness_option(commands, model, arguments)
    resume_requested, resume_id, forwarded = parse_resume_option(forwarded)
    invocation_harness = explicit or defaults_with_sources(commands)[model][0]
    harness = invocation_harness
    mode_arguments = (resume_arguments(harness, resume_id) if resume_requested else []) + forwarded
    interactive = interactive_invocation(harness, mode_arguments)
    if resume_id is not None:
        selected = select_resume(resume_id, explicit, invocation_harness, interactive)
        resume_id, harness = selected.session_id, selected.harness
    invocation = resume_model_route(commands, model, harness, invocation_harness, interactive)
    if resume_requested:
        invocation.extend(resume_arguments(harness, resume_id))
    invocation.extend(forwarded)
    return invocation, harness


def session_cli_arguments(arguments: list[str]) -> tuple[str, str | None]:
    agent = None
    rest = []
    iterator = iter(arguments)
    for argument in iterator:
        if argument == "--agent" or argument.startswith("--agent="):
            if agent is not None:
                raise ConfigError("--agent may only be given once")
            agent = next(iterator, "") if argument == "--agent" else argument.partition("=")[2]
            if agent not in HARNESS_RESUME_ARGUMENTS:
                raise ConfigError("--agent requires a supported harness name")
        else:
            rest.append(argument)
    if len(rest) != 1 or not rest[0].strip() or rest[0].startswith("-"):
        raise ConfigError("expected one session query")
    return rest[0], agent


def command_verify_session(arguments: list[str]) -> int:
    query, agent = session_cli_arguments(arguments)
    native_id, prefix = normalize_resume_id(query)
    if agent is None or not NATIVE_ID_PATTERN.fullmatch(native_id):
        raise ConfigError("verify-session requires an exact native ID and --agent HARNESS")
    if prefix is not None and prefix != agent:
        return 3
    resolution = exact_session(query)
    if not resolution.matches or resolution.matches[0].harness != agent:
        return 3
    print(native_id)
    print(agent)
    return 0


def command_resolve_session(arguments: list[str]) -> int:
    """Three lines on success; 3 definitive miss; 4 unavailable; 2 invalid/cancelled."""
    query, agent = session_cli_arguments(arguments)
    resolution = resolve_resume_target(query)
    if not resolution.matches:
        reason = "No matching conversation" if resolution.conclusive else "Lookup unavailable"
        print(f"agent-model: {reason}: {query!r}", file=sys.stderr)
        return 3 if resolution.conclusive else 4
    # Selection policy is shared with both launching entrypoints.
    chosen = select_matches(resolution.matches, query, agent, interactive_invocation(agent or "", []))
    print(chosen.session_id)
    print(chosen.harness)
    print(shlex.join([chosen.harness, *HARNESS_RESUME_ARGUMENTS[chosen.harness]]))
    return 0

NATIVE_RESUME_FLAGS = {
    "claude": {"--resume", "-r"},
    "codex": {"resume"},
    "omp": {"--resume", "-r"},
    "kimi": {"--resume", "-r", "--session", "-S"},
    "opencode": {"--session", "-s"},
    "agy": {"--conversation"},
}


def command_prepare_resume(commands: dict[str, Command], arguments: list[str]) -> int:
    """Internal Bash boundary: emit NUL-delimited owning harness and argv."""
    if not arguments or arguments[0] not in NATIVE_RESUME_FLAGS:
        raise ConfigError("prepare-resume requires a supported harness")
    harness, forwarded = arguments[0], arguments[1:]
    interactive = False
    if forwarded[:1] == ["--interactive"]:
        interactive = sys.stdin.isatty()
        forwarded = forwarded[1:]
    if forwarded[:1] != ["--"]:
        raise ConfigError("prepare-resume requires -- before harness arguments")
    forwarded = forwarded[1:]
    interactive = interactive and not headless_invocation(harness, forwarded)
    invocation = [harness, *forwarded]
    skip_value = False
    for index, argument in enumerate(forwarded):
        if skip_value:
            skip_value = False
            continue
        if argument == "--":
            break
        flag, attached, value = argument.partition("=")
        if flag not in NATIVE_RESUME_FLAGS[harness]:
            if not attached and argument_takes_value(harness, flag):
                skip_value = True
            elif harness == "codex" and not argument.startswith("-") and argument not in {"exec", "e"}:
                break
            continue
        end = index + 1
        if not attached:
            value = forwarded[end] if end < len(forwarded) else ""
            end += 1
        if not value or value.startswith("-"):
            continue
        chosen = select_resume(value, harness, harness, interactive)
        if chosen.harness == harness:
            replacement = [f"{flag}={chosen.session_id}"] if attached else [flag, chosen.session_id]
            invocation = [harness, *forwarded[:index], *replacement, *forwarded[end:]]
        else:
            remaining = forwarded[:index] + forwarded[end:]
            model_value = None
            model_free = []
            model_index = 0
            while model_index < len(remaining):
                model_arg = remaining[model_index]
                if model_arg == "--":
                    model_free.extend(remaining[model_index:])
                    break
                model_flag, model_attached, model_value_candidate = model_arg.partition("=")
                if model_arg.startswith("-m") and not model_attached and len(model_arg) > 2:
                    model_flag, model_attached, model_value_candidate = "-m", "=", model_arg[2:]
                if model_flag not in {"--model", "-m"}:
                    model_free.append(model_arg)
                    model_index += 1
                    continue
                model_index += 1
                if not model_attached:
                    if model_index >= len(remaining):
                        raise ConfigError(f"{model_flag} requires a model")
                    model_value_candidate = remaining[model_index]
                    model_index += 1
                # The provider's last model flag wins; remove every source
                # spelling so none can override the translated route.
                model_value = model_value_candidate
            remaining = model_free
            route = [chosen.harness]
            if model_value is not None:
                # Reverse only an exact configured route; never guess by model family.
                model = model_value
                for name, command in commands.items():
                    source = command.routes.get(harness, ())
                    selector = source[-1].removeprefix("--model=") if len(source) > 1 else None
                    if model_value == name or model_value == selector:
                        model = name
                        break
                route = resume_model_route(commands, model, chosen.harness, harness, interactive)
            invocation = [
                *route, *resume_arguments(chosen.harness, chosen.session_id), *remaining,
            ]
        break
    sys.stdout.buffer.write(b"".join(os.fsencode(value) + b"\0" for value in invocation))
    return 0



def print_usage(commands: dict[str, Command], file: object = sys.stdout) -> None:
    print(
        f"""Usage:
  agent-model launch MODEL [--harness HARNESS | -h HARNESS] [--resume [SESSION]] [ARG ...]
  agent-model resolve MODEL [--harness HARNESS | -h HARNESS] [--resume [SESSION]] [ARG ...]
  agent-model resolve-session QUERY [--agent AGENT]
  agent-model verify-session ID --agent HARNESS
  agent-model default list
  agent-model default get MODEL
  agent-model default set MODEL HARNESS
  agent-model default reset MODEL
  agent-model config path
  agent-model config check
  agent-model doctor

Models: {", ".join(commands)}
Harness aliases: own, self, and . select the model's native harness.

A SESSION is a session id, an agent-mail session name ("Efficient Deer"), or
text from the session's transcript. The last two resolve to an id, selecting
the most recent session when several match.

The harness option is recognized only immediately after MODEL. A bare -h, or
-h followed by an unknown harness, is forwarded to the selected harness.""",
        file=file,
    )


def command_default(commands: dict[str, Command], arguments: list[str]) -> int:
    if not arguments or arguments[0] == "list":
        if len(arguments) > 1:
            raise ConfigError("default list takes no arguments")
        resolved = defaults_with_sources(commands)
        print("MODEL   DEFAULT   HOME       SOURCE")
        for model, command in commands.items():
            harness, source = resolved[model]
            print(f"{model:<7} {harness:<9} {command.home:<10} {source}")
        return 0
    action = arguments[0]
    if action == "get" and len(arguments) == 2:
        model = arguments[1]
        if model not in commands:
            raise ConfigError(f"unknown model {model!r}")
        harness, source = defaults_with_sources(commands)[model]
        print(f"{model} = {harness} ({source})")
        return 0
    if action == "set" and len(arguments) == 3:
        model, requested = arguments[1:]
        if model not in commands:
            raise ConfigError(f"unknown model {model!r}")
        harness = _canonical_harness(commands, model, requested, "default set")
        defaults = read_config(commands)
        defaults[model] = harness
        write_config(commands, defaults)
        print(f"{model} = {harness}")
        return 0
    if action == "reset" and len(arguments) == 2:
        model = arguments[1]
        if model not in commands:
            raise ConfigError(f"unknown model {model!r}")
        defaults = read_config(commands)
        defaults.pop(model, None)
        write_config(commands, defaults)
        print(f"{model} = {commands[model].default} (shipped)")
        return 0
    raise ConfigError("expected default list|get MODEL|set MODEL HARNESS|reset MODEL")


def command_config(commands: dict[str, Command], arguments: list[str]) -> int:
    if arguments == ["path"]:
        print(config_path())
        return 0
    if arguments == ["check"]:
        read_config(commands)
        print(f"OK defaults: {DEFAULTS_PATH}")
        path = config_path()
        if path.exists():
            print(f"OK config: {path}")
        else:
            print(f"OK config: absent; using shipped defaults ({path})")
        return 0
    raise ConfigError("expected config path or config check")


def command_doctor(commands: dict[str, Command], arguments: list[str]) -> int:
    if arguments:
        raise ConfigError("doctor takes no arguments")
    defaults = defaults_with_sources(commands)
    print(f"OK defaults: {DEFAULTS_PATH}")
    print(f"OK config: {config_path() if config_path().exists() else 'absent; shipped defaults'}")
    failed = False
    harnesses = sorted(known_harnesses(commands))
    for harness in harnesses:
        location = shutil.which(harness)
        if location is None:
            print(f"FAIL executable: {harness} not found")
            failed = True
        else:
            print(f"OK executable: {harness} -> {location}")
    for model, command in commands.items():
        harness, source = defaults[model]
        print(f"OK default: {model} -> {harness} ({source}, home {command.home})")
    return 1 if failed else 0


def main(arguments: list[str]) -> int:
    commands = read_commands()
    if not arguments or arguments == ["--help"] or arguments == ["-h"]:
        print_usage(commands)
        return 0 if arguments else 2
    command, rest = arguments[0], arguments[1:]
    if command in ("launch", "resolve"):
        if not rest:
            raise ConfigError(f"{command} requires a model name")
        invocation, _ = resolve(commands, rest[0], rest[1:])
        if command == "resolve":
            print(shlex.join(invocation))
            return 0
        try:
            os.execvp(invocation[0], invocation)
        except FileNotFoundError as error:
            raise ConfigError(
                f"harness executable {invocation[0]!r} was not found on PATH"
            ) from error
        raise AssertionError("execvp returned")
    if command == "default":
        return command_default(commands, rest)
    if command == "resolve-session":
        return command_resolve_session(rest)
    if command == "verify-session":
        return command_verify_session(rest)
    if command == "prepare-resume":
        return command_prepare_resume(commands, rest)
    if command == "config":
        return command_config(commands, rest)
    if command == "doctor":
        return command_doctor(commands, rest)
    raise ConfigError(f"unknown command {command!r}")


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except ConfigError as error:
        print(f"agent-model: {error}", file=sys.stderr)
        raise SystemExit(2)
