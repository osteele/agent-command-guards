#!/usr/bin/env python3
"""Resolve model-first interactive commands to guarded agent harnesses."""

from __future__ import annotations

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from collections.abc import Iterable
from pathlib import Path
from typing import NamedTuple


# Shipped defaults. Kept out of the launcher directories, which are PATH
# entries where every file becomes a command name.
DEFAULTS_PATH = Path(__file__).resolve().parent.parent / "agent-models.toml"

# How each harness spells the fields a route may carry. A flag ending in "="
# joins its value; anything else passes the value as the following argument.
# Flag spellings are the harness's API, not a preference, so they stay here
# while the model names they carry live in the defaults file.
HARNESS_FLAGS: dict[str, dict[str, str]] = {
    "claude": {"model": "--model"},
    "codex": {},
    "kimi": {"model": "-m"},
    "opencode": {"model": "-m"},
    "omp": {"model": "--model="},
}

# The model-first commands expose one resume spelling. Each harness receives
# the spelling from its own CLI instead.
HARNESS_RESUME_ARGUMENTS: dict[str, tuple[str, ...]] = {
    "claude": ("--resume",),
    "codex": ("resume",),
    "kimi": ("--session",),
    "opencode": ("--session",),
    "omp": ("--resume",),
}
RESUME_ID_PATTERNS = (
    ("kimi", re.compile(r"session_[0-9a-fA-F-]{36}")),
    ("opencode", re.compile(r"ses_[A-Za-z0-9]{10,}")),
)
# The shapes an agent resolves itself. Anything else named to --resume is a
# session *name* or transcript text, resolved to one of these before exec.
_UUID = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
NATIVE_ID_PATTERN = re.compile(rf"(?:session_)?{_UUID}|ses_[A-Za-z0-9]{{10,}}")

# agent-mail's durable store of generated session names, keyed by a hash of the
# session id: {"sessionId", "assignedAt", "slug", "displayName"}. Read directly
# because agent-mail's CLI resolves a name only for a *live* session, and a
# session worth resuming has usually exited. Absent, unreadable, and malformed
# records are all "no match" rather than an error.
SESSION_NAMES_DIR = Path.home() / ".claude" / "agent-mail" / "session-names"

# Candidates carried into the per-session AgentsView lookups that a collision
# needs. A name collides a handful of times at most; this bounds the cost of a
# pathological one.
NAME_CANDIDATE_LIMIT = 8
# Rendered in this order, so an invocation does not depend on file key order.
ROUTE_FIELDS = ("model",)


class ConfigError(ValueError):
    """The configuration is malformed or unsupported."""


class Command(NamedTuple):
    """One model-first command: its harnesses and which of them to use."""

    home: str
    default: str
    routes: dict[str, tuple[str, ...]]


def config_path() -> Path:
    root = os.environ.get("XDG_CONFIG_HOME")
    config_root = Path(root).expanduser() if root else Path.home() / ".config"
    return config_root / "agent-models" / "config.toml"


def _load_toml(path: Path) -> dict[str, object]:
    try:
        content = path.read_bytes()
    except OSError as error:
        raise ConfigError(f"{path}: cannot read: {error}") from error
    try:
        return tomllib.loads(content.decode())
    except UnicodeDecodeError as error:
        raise ConfigError(f"{path}: not UTF-8: {error}") from error
    except tomllib.TOMLDecodeError as error:
        raise ConfigError(f"{path}: invalid TOML: {error}") from error


def _table(value: object, location: str) -> dict[str, object]:
    if not isinstance(value, dict):
        raise ConfigError(f"{location}: expected a table")
    return value


def _string(value: object, location: str) -> str:
    if not isinstance(value, str) or not value:
        raise ConfigError(f"{location}: expected a non-empty string")
    return value


def _check_version(raw: dict[str, object], location: str) -> None:
    if raw.get("version") != 1:
        raise ConfigError(f"{location}: expected version = 1")


def render_route(harness: str, fields: dict[str, object], location: str) -> tuple[str, ...]:
    accepted = HARNESS_FLAGS[harness]
    for key in fields:
        if key not in accepted:
            expected = ", ".join(sorted(accepted)) or "no fields"
            raise ConfigError(f"{location}.{key}: {harness} accepts {expected}")
    invocation = [harness]
    for key in ROUTE_FIELDS:
        if key not in fields:
            continue
        value = _string(fields[key], f"{location}.{key}")
        flag = accepted[key]
        if flag.endswith("="):
            invocation.append(f"{flag}{value}")
        else:
            invocation.extend((flag, value))
    return tuple(invocation)


def read_commands(path: Path | None = None) -> dict[str, Command]:
    selected_path = path or DEFAULTS_PATH
    raw = _load_toml(selected_path)
    _check_version(raw, str(selected_path))
    unknown = set(raw) - {"version", "commands"}
    if unknown:
        raise ConfigError(f"{selected_path}: unknown key {sorted(unknown)[0]!r}")
    table = _table(raw.get("commands", {}), f"{selected_path}: commands")
    if not table:
        raise ConfigError(f"{selected_path}: commands is empty")

    commands: dict[str, Command] = {}
    for name, entry in table.items():
        location = f"{selected_path}: commands.{name}"
        fields = _table(entry, location)
        unknown = set(fields) - {"home", "default", "routes"}
        if unknown:
            raise ConfigError(f"{location}: unknown key {sorted(unknown)[0]!r}")
        route_table = _table(fields.get("routes", {}), f"{location}.routes")
        if not route_table:
            raise ConfigError(f"{location}.routes: expected at least one harness")
        routes: dict[str, tuple[str, ...]] = {}
        for harness, route_fields in route_table.items():
            route_location = f"{location}.routes.{harness}"
            if harness not in HARNESS_FLAGS:
                expected = ", ".join(sorted(HARNESS_FLAGS))
                raise ConfigError(f"{route_location}: unknown harness; expected {expected}")
            routes[harness] = render_route(
                harness, _table(route_fields, route_location), route_location
            )
        command = Command(
            home=_string(fields.get("home"), f"{location}.home"),
            default=_string(fields.get("default"), f"{location}.default"),
            routes=routes,
        )
        for key in ("home", "default"):
            harness = getattr(command, key)
            if harness not in routes:
                expected = ", ".join(sorted(routes))
                raise ConfigError(
                    f"{location}.{key}: {harness!r} has no route; expected {expected}"
                )
        commands[name] = command
    return commands


def known_harnesses(commands: dict[str, Command]) -> set[str]:
    return {harness for command in commands.values() for harness in command.routes}


def _canonical_harness(
    commands: dict[str, Command], model: str, harness: str, location: str
) -> str:
    command = commands[model]
    if harness in {"own", "self", "."}:
        return command.home
    if harness not in known_harnesses(commands):
        aliases = {"own", "self", "."}
        expected = ", ".join(sorted(known_harnesses(commands) | aliases))
        raise ConfigError(f"{location}: unknown harness {harness!r}; expected {expected}")
    if harness not in command.routes:
        expected = ", ".join(sorted(command.routes))
        raise ConfigError(
            f"{location}: {model} does not support harness {harness!r}; "
            f"expected {expected}, own, self, or ."
        )
    return harness


def read_config(commands: dict[str, Command], path: Path | None = None) -> dict[str, str]:
    selected_path = path or config_path()
    if not selected_path.exists():
        return {}
    raw = _load_toml(selected_path)
    _check_version(raw, str(selected_path))
    unknown = set(raw) - {"version", "defaults"}
    if unknown:
        raise ConfigError(f"{selected_path}: unknown key {sorted(unknown)[0]!r}")

    defaults: dict[str, str] = {}
    table = _table(raw.get("defaults", {}), f"{selected_path}: defaults")
    for model, value in table.items():
        location = f"{selected_path}: defaults.{model}"
        if model not in commands:
            raise ConfigError(f"{location}: unknown model {model!r}")
        harness = _string(value, location)
        defaults[model] = _canonical_harness(commands, model, harness, location)
    return defaults


def write_config(
    commands: dict[str, Command], defaults: dict[str, str], path: Path | None = None
) -> None:
    selected_path = path or config_path()
    selected_path.parent.mkdir(parents=True, exist_ok=True)
    content = ["version = 1", "", "[defaults]"]
    content.extend(f'{model} = "{defaults[model]}"' for model in commands if model in defaults)
    content.append("")
    temporary_name: str | None = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", dir=selected_path.parent, prefix=".config.toml.", delete=False
        ) as temporary:
            temporary.write("\n".join(content))
            temporary_name = temporary.name
        os.replace(temporary_name, selected_path)
    finally:
        if temporary_name is not None:
            try:
                Path(temporary_name).unlink()
            except FileNotFoundError:
                pass


def defaults_with_sources(commands: dict[str, Command]) -> dict[str, tuple[str, str]]:
    configured = read_config(commands)
    return {
        model: (
            configured.get(model, command.default),
            "config" if model in configured else "shipped",
        )
        for model, command in commands.items()
    }


def parse_harness_option(
    commands: dict[str, Command], model: str, arguments: list[str]
) -> tuple[str | None, list[str]]:
    if not arguments:
        return None, arguments
    first = arguments[0]
    if first == "--harness":
        if len(arguments) == 1:
            raise ConfigError("--harness requires a harness name")
        return _canonical_harness(commands, model, arguments[1], "--harness"), arguments[2:]
    if first.startswith("--harness="):
        harness = first.partition("=")[2]
        if not harness:
            raise ConfigError("--harness requires a harness name")
        return _canonical_harness(commands, model, harness, "--harness"), arguments[1:]
    if first == "-h" and len(arguments) > 1:
        candidate = arguments[1]
        aliases = {"own", "self", "."}
        if candidate in known_harnesses(commands) or candidate in aliases:
            return _canonical_harness(commands, model, candidate, "-h"), arguments[2:]
    return None, arguments


def parse_resume_option(
    arguments: list[str],
) -> tuple[bool, str | None, list[str]]:
    """Remove one launcher-level --resume option and return its session id."""
    for index, argument in enumerate(arguments):
        if argument == "--":
            break
        if argument == "--resume":
            if index + 1 < len(arguments) and not arguments[index + 1].startswith("-"):
                return (
                    True,
                    arguments[index + 1],
                    arguments[:index] + arguments[index + 2 :],
                )
            return True, None, arguments[:index] + arguments[index + 1 :]
        if argument.startswith("--resume="):
            session_id = argument.partition("=")[2] or None
            return True, session_id, arguments[:index] + arguments[index + 1 :]
    return False, None, arguments


def normalize_resume_id(session_id: str) -> tuple[str, str | None]:
    """Convert an AgentsView canonical id to the harness's native id."""
    for harness in HARNESS_RESUME_ARGUMENTS:
        prefix = f"{harness}:"
        if not session_id.startswith(prefix):
            continue
        native_id = session_id.rsplit(":", 1)[-1] if harness == "kimi" else session_id[len(prefix) :]
        return native_id, harness
    return session_id, None


def _agentsview_json(arguments: list[str], timeout: float = 10.0) -> object | None:
    """Run one AgentsView query and return its parsed JSON, or None.

    None covers every way the answer can be missing: AgentsView not installed,
    the query failing, and output that is not JSON. A miss is not an error here
    — the caller has other ways to resolve the same value.
    """
    return _agentsview_query(arguments, timeout)[0]


def _agentsview_query(
    arguments: list[str], timeout: float = 10.0
) -> tuple[object | None, bool]:
    """The parsed JSON, and whether AgentsView actually answered.

    Callers that treat a missing record as evidence need the second value: an
    uninstalled, hung, or erroring AgentsView returns no record either, and
    reading that as "this session does not exist" turns an outage into a
    confident wrong answer.
    """
    agentsview = shutil.which("agentsview")
    if agentsview is None:
        return None, False
    try:
        result = subprocess.run(
            [agentsview, *arguments, "--json"],
            capture_output=True,
            check=False,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f"agent-model: AgentsView lookup failed: {error}", file=sys.stderr)
        return None, False
    if result.returncode != 0:
        # A query AgentsView ran and answered negatively. "not found" is an
        # answer; anything else is the tool failing to answer at all.
        return None, "not found" in result.stderr.casefold()
    try:
        return json.loads(result.stdout), True
    except json.JSONDecodeError as error:
        print(f"agent-model: AgentsView returned invalid JSON: {error}", file=sys.stderr)
        return None, False


def session_metadata(session_id: str) -> dict[str, object] | None:
    """AgentsView's record for one session id, or None when it knows none."""
    metadata = _agentsview_json(["session", "get", session_id])
    return metadata if isinstance(metadata, dict) else None


def _metadata_harness(metadata: dict[str, object] | None) -> str | None:
    if metadata is None:
        return None
    agent = metadata.get("agent")
    if not isinstance(agent, str):
        print(
            "agent-model: AgentsView returned session metadata without an agent",
            file=sys.stderr,
        )
        return None
    return agent if agent in HARNESS_RESUME_ARGUMENTS else None


def infer_resume_harness(session_id: str) -> str | None:
    """Identify the harness from a native id shape or AgentsView metadata."""
    for harness, pattern in RESUME_ID_PATTERNS:
        if pattern.fullmatch(session_id):
            return harness
    return _metadata_harness(session_metadata(session_id))


class SessionMatch(NamedTuple):
    """One session a --resume argument could name."""

    session_id: str
    harness: str | None
    recency: str
    label: str
    indexed: bool = False


# Session ids naming the session this process is running inside. Resuming the
# session you are typing in is never the intent, and a phrase the user has just
# typed is in that session's transcript, so search finds it.
CURRENT_SESSION_VARIABLES = (
    "AGENT_SESSION_ID",
    "CLAUDE_CODE_SESSION_ID",
    "CODEX_THREAD_ID",
)


def current_session_ids() -> set[str]:
    ids = set()
    for variable in CURRENT_SESSION_VARIABLES:
        value = os.environ.get(variable, "").strip()
        if value:
            ids.add(normalize_resume_id(value)[0])
    return ids


def _name_matches(query: str, slug: str, display_name: str) -> bool:
    """Whether `query` names this session.

    Accepts what the surfaces show: the display name ("Efficient Deer"), the
    slug ("efficient-deer"), and the project-qualified full name agent-mail
    addresses sessions by ("augur-efficient-deer").
    """
    normalized = query.casefold()
    if normalized in (display_name.casefold(), slug.casefold()):
        return True
    return bool(slug) and normalized.endswith(f"-{slug.casefold()}")


def _name_prefilter(query: str) -> bytes:
    """The one token every accepted spelling of a name must contain.

    A generated name ends in its noun, whether it arrives as "Efficient Deer",
    "efficient-deer", or "augur-efficient-deer". Requiring that word of the raw
    bytes skips the decode and JSON parse for all but a handful of records, and
    the store holds one per session ever named -- 3700 of them on this machine,
    where decoding every record costs four times reading them all.
    """
    tokens = re.findall(r"[0-9A-Za-z]+", query.casefold())
    return tokens[-1].encode("ascii") if tokens else b""


def sessions_named(query: str, directory: Path = SESSION_NAMES_DIR) -> list[SessionMatch]:
    """Sessions whose agent-mail name is `query`, most recently named first."""
    try:
        entries = sorted(directory.iterdir())
    except OSError:
        return []
    prefilter = _name_prefilter(query)
    matches: list[SessionMatch] = []
    unreadable = 0
    for entry in entries:
        if entry.suffix != ".json":
            continue
        try:
            content = entry.read_bytes()
        except OSError:
            unreadable += 1
            continue
        if prefilter and prefilter not in content.lower():
            continue
        try:
            record = json.loads(content)
        except (UnicodeDecodeError, json.JSONDecodeError):
            unreadable += 1
            continue
        if not isinstance(record, dict):
            unreadable += 1
            continue
        session_id = record.get("sessionId")
        slug = record.get("slug")
        display_name = record.get("displayName")
        if not isinstance(session_id, str) or not isinstance(slug, str):
            unreadable += 1
            continue
        if not isinstance(display_name, str):
            display_name = slug
        if not _name_matches(query, slug, display_name):
            continue
        assigned = record.get("assignedAt")
        matches.append(
            SessionMatch(
                session_id=session_id,
                harness=None,
                recency=assigned if isinstance(assigned, str) else "",
                label=session_id,
            )
        )
    if unreadable and not matches:
        print(
            f"agent-model: skipped {unreadable} unreadable session-name "
            f"records under {directory}",
            file=sys.stderr,
        )
    return _ranked(matches)


def _described(match: SessionMatch, metadata: dict[str, object] | None) -> SessionMatch:
    """Fill in the harness and a human label from AgentsView metadata."""
    if metadata is None:
        return match
    agent = metadata.get("agent")
    project = metadata.get("project")
    started = metadata.get("started_at")
    parts = [part for part in (agent, project) if isinstance(part, str)]
    if isinstance(started, str):
        parts.append(started[:10])
    return match._replace(
        harness=_metadata_harness(metadata),
        label=f"{match.label} ({', '.join(parts)})" if parts else match.label,
        indexed=True,
    )


def sessions_containing(query: str, agent: str | None = None) -> list[SessionMatch]:
    """Sessions whose transcript contains `query`, most recent match first."""
    # --fts is the tokenized index over message text. The default search also
    # reads tool arguments and results, and takes ~40s against this machine's
    # archive against ~0.5s for the index -- too slow to sit in front of a
    # launch. Remembered text is almost always something that was *said*.
    arguments = ["session", "search", query, "--fts", "--limit", "50"]
    if agent is not None:
        arguments.extend(("--agent", agent))
    payload = _agentsview_json(arguments, timeout=30.0)
    if not isinstance(payload, dict) or not isinstance(payload.get("matches"), list):
        return []
    matches: dict[str, SessionMatch] = {}
    for entry in payload["matches"]:
        if not isinstance(entry, dict):
            continue
        canonical = entry.get("session_id")
        if not isinstance(canonical, str):
            continue
        session_id, harness = normalize_resume_id(canonical)
        timestamp = entry.get("timestamp")
        project = entry.get("project")
        described = [part for part in (harness, project) if isinstance(part, str)]
        recency = timestamp if isinstance(timestamp, str) else ""
        existing = matches.get(session_id)
        if existing is not None and existing.recency >= recency:
            continue
        matches[session_id] = SessionMatch(
            session_id=session_id,
            harness=harness,
            recency=recency,
            label=f"{canonical} ({', '.join(described)})" if described else canonical,
            indexed=True,
        )
    return _ranked(matches.values())


CLAUDE_PROJECTS_DIR = Path.home() / ".claude" / "projects"


def claude_transcript_exists(
    session_id: str, directory: Path = CLAUDE_PROJECTS_DIR
) -> bool:
    """Whether a Claude Code transcript is named after this session id.

    This is the resumability test for a Claude session: `--resume` opens the
    file named after the id, so a missing file is a missing conversation.

    Local and instant, which is why it is asked first. AgentsView answers a hit
    in ~0.1s but concludes a miss only after scanning its whole archive -- 16s
    on this machine, which is where the launch-time timeouts came from.
    """
    if not session_id:
        return False
    try:
        return any(directory.glob(f"*/{session_id}.jsonl"))
    except OSError:
        return False


def _resumable(match: SessionMatch) -> bool:
    """Whether resuming this match could reach a conversation.

    A name can resolve to an id that no longer opens anything. Claude Code
    mints a fresh session id for each *run* of a resumed conversation and
    appends to the original transcript, so the run's id names no file --
    agent-mail still named that run, so its name lives in the store pointing at
    an id `--resume` answers "No conversation found with session ID" for.

    Dropped only on evidence. An AgentsView that did not answer proves nothing,
    and reading its silence as absence would turn an outage into a confident
    wrong answer.
    """
    if claude_transcript_exists(match.session_id):
        return True
    record, answered = _agentsview_query(["session", "get", match.session_id])
    if record is not None:
        return True
    return not answered


def _ranked(matches: Iterable[SessionMatch]) -> list[SessionMatch]:
    """Newest first, and a session some index knows ahead of one none does.

    A name the archive cannot place is usually a session whose transcript has
    been pruned; resuming a described session is likelier to reach something.
    """
    current = current_session_ids()
    candidates = [match for match in matches if match.session_id not in current]
    return sorted(
        candidates, key=lambda match: (match.indexed, match.recency), reverse=True
    )


def _preferred(matches: list[SessionMatch], agent: str | None) -> list[SessionMatch]:
    """Matches for the requested agent, or every match when it names none.

    The agent is a preference rather than a filter: a caller that finds a
    session belonging to another harness can say so, which is more use than
    reporting no match at all.
    """
    if agent is None:
        return matches
    preferred = [match for match in matches if match.harness == agent]
    return preferred or matches


def _selected(matches: list[SessionMatch], query: str) -> SessionMatch:
    """The newest match, reporting the others it was chosen over."""
    chosen = matches[0]
    if len(matches) > 1:
        others = ", ".join(match.label for match in matches[1:4])
        print(
            f"agent-model: {len(matches)} sessions match {query!r}; resuming "
            f"{chosen.label}. Others: {others}. Pass a session id to select one.",
            file=sys.stderr,
        )
    return chosen


def resolve_resume_target(query: str, agent: str | None = None) -> SessionMatch | None:
    """Resolve a --resume argument that is not already a native session id.

    Tried in order of how specific the answer is: an id AgentsView knows, an
    agent-mail session name, then text from a transcript. Returns None when
    nothing resolves, leaving the argument to reach the agent as typed.
    """
    if not query.strip():
        return None
    if not any(character.isspace() for character in query):
        metadata = session_metadata(query)
        harness = _metadata_harness(metadata)
        if metadata is not None:
            return _described(SessionMatch(query, harness, "", query), metadata)

    named = sessions_named(query)
    if named:
        described = _ranked(
            _described(match, session_metadata(match.session_id))
            for match in named[:NAME_CANDIDATE_LIMIT]
            if _resumable(match)
        )
        if described:
            return _selected(_preferred(described, agent), query)

    contained = sessions_containing(query, agent)
    if contained:
        return _selected(_preferred(contained, agent), query)
    return None


def resume_arguments(harness: str, session_id: str | None) -> list[str]:
    arguments = list(HARNESS_RESUME_ARGUMENTS[harness])
    if session_id is not None:
        arguments.append(session_id)
    return arguments


def resolve(
    commands: dict[str, Command], model: str, arguments: list[str]
) -> tuple[list[str], str]:
    if model not in commands:
        raise ConfigError(f"unknown model {model!r}; expected {', '.join(commands)}")
    explicit, forwarded = parse_harness_option(commands, model, arguments)
    resume_requested, resume_id, forwarded = parse_resume_option(forwarded)
    prefixed_harness = None
    if resume_id is not None:
        resume_id, prefixed_harness = normalize_resume_id(resume_id)
        # A name or a line of transcript text resolves to a native id here, so
        # everything downstream sees an id the harness can open. An explicit
        # harness still narrows the search, and still wins the routing below.
        if prefixed_harness is None and not NATIVE_ID_PATTERN.fullmatch(resume_id):
            resolved = resolve_resume_target(resume_id, explicit)
            if resolved is not None:
                resume_id = resolved.session_id
                prefixed_harness = resolved.harness
    inferred = (
        prefixed_harness or infer_resume_harness(resume_id)
        if resume_id is not None and explicit is None
        else None
    )
    if explicit is not None:
        harness = explicit
    elif inferred is not None:
        harness = inferred
    else:
        harness, _ = defaults_with_sources(commands)[model]

    if harness in commands[model].routes:
        invocation = list(commands[model].routes[harness])
    elif resume_requested and inferred == harness:
        # A resumed session already owns its model. This keeps an inferred
        # foreign harness usable even when the model command has no route to it.
        invocation = [harness]
    else:
        raise AssertionError(f"unresolved route for {model} through {harness}")
    if resume_requested:
        invocation.extend(resume_arguments(harness, resume_id))
    invocation.extend(forwarded)
    return invocation, harness


def command_resolve_session(arguments: list[str]) -> int:
    """Print the session id one --resume argument names, and its harness.

    Three lines: the native session id, the harness that owns it, and how that
    harness spells a resume -- the last two empty when nothing could say. Exit 3
    means nothing matched, which is a caller's cue to pass the argument through
    rather than a failure.
    """
    agent: str | None = None
    rest = list(arguments)
    for index, argument in enumerate(rest):
        if argument == "--agent":
            if index + 1 >= len(rest):
                raise ConfigError("--agent requires an agent name")
            agent = rest[index + 1]
            rest = rest[:index] + rest[index + 2 :]
            break
        if argument.startswith("--agent="):
            agent = argument.partition("=")[2]
            if not agent:
                raise ConfigError("--agent requires an agent name")
            rest = rest[:index] + rest[index + 1 :]
            break
    if len(rest) != 1:
        raise ConfigError("resolve-session takes one query")
    resolved = resolve_resume_target(rest[0], agent)
    if resolved is None:
        return 3
    print(resolved.session_id)
    print(resolved.harness or "")
    if resolved.harness is not None:
        print(shlex.join([resolved.harness, *HARNESS_RESUME_ARGUMENTS[resolved.harness]]))
    else:
        print("")
    return 0


def print_usage(commands: dict[str, Command], file: object = sys.stdout) -> None:
    print(
        f"""Usage:
  agent-model launch MODEL [--harness HARNESS | -h HARNESS] [--resume [SESSION]] [ARG ...]
  agent-model resolve MODEL [--harness HARNESS | -h HARNESS] [--resume [SESSION]] [ARG ...]
  agent-model resolve-session QUERY [--agent AGENT]
  agent-model default list
  agent-model default get MODEL
  agent-model default set MODEL HARNESS
  agent-model default reset MODEL
  agent-model config path
  agent-model config check
  agent-model doctor

Models: {", ".join(commands)}
Harness aliases: own, self, and . select the model's native harness.

A SESSION is a session id, an agent-mail session name ("Efficient Deer"), or
text from the session's transcript. The last two resolve to an id, selecting
the most recent session when several match.

The harness option is recognized only immediately after MODEL. A bare -h, or
-h followed by an unknown harness, is forwarded to the selected harness.""",
        file=file,
    )


def command_default(commands: dict[str, Command], arguments: list[str]) -> int:
    if not arguments or arguments[0] == "list":
        if len(arguments) > 1:
            raise ConfigError("default list takes no arguments")
        resolved = defaults_with_sources(commands)
        print("MODEL   DEFAULT   HOME       SOURCE")
        for model, command in commands.items():
            harness, source = resolved[model]
            print(f"{model:<7} {harness:<9} {command.home:<10} {source}")
        return 0
    action = arguments[0]
    if action == "get" and len(arguments) == 2:
        model = arguments[1]
        if model not in commands:
            raise ConfigError(f"unknown model {model!r}")
        harness, source = defaults_with_sources(commands)[model]
        print(f"{model} = {harness} ({source})")
        return 0
    if action == "set" and len(arguments) == 3:
        model, requested = arguments[1:]
        if model not in commands:
            raise ConfigError(f"unknown model {model!r}")
        harness = _canonical_harness(commands, model, requested, "default set")
        defaults = read_config(commands)
        defaults[model] = harness
        write_config(commands, defaults)
        print(f"{model} = {harness}")
        return 0
    if action == "reset" and len(arguments) == 2:
        model = arguments[1]
        if model not in commands:
            raise ConfigError(f"unknown model {model!r}")
        defaults = read_config(commands)
        defaults.pop(model, None)
        write_config(commands, defaults)
        print(f"{model} = {commands[model].default} (shipped)")
        return 0
    raise ConfigError("expected default list|get MODEL|set MODEL HARNESS|reset MODEL")


def command_config(commands: dict[str, Command], arguments: list[str]) -> int:
    if arguments == ["path"]:
        print(config_path())
        return 0
    if arguments == ["check"]:
        read_config(commands)
        print(f"OK defaults: {DEFAULTS_PATH}")
        path = config_path()
        if path.exists():
            print(f"OK config: {path}")
        else:
            print(f"OK config: absent; using shipped defaults ({path})")
        return 0
    raise ConfigError("expected config path or config check")


def command_doctor(commands: dict[str, Command], arguments: list[str]) -> int:
    if arguments:
        raise ConfigError("doctor takes no arguments")
    defaults = defaults_with_sources(commands)
    print(f"OK defaults: {DEFAULTS_PATH}")
    print(f"OK config: {config_path() if config_path().exists() else 'absent; shipped defaults'}")
    failed = False
    harnesses = sorted(known_harnesses(commands))
    for harness in harnesses:
        location = shutil.which(harness)
        if location is None:
            print(f"FAIL executable: {harness} not found")
            failed = True
        else:
            print(f"OK executable: {harness} -> {location}")
    for model, command in commands.items():
        harness, source = defaults[model]
        print(f"OK default: {model} -> {harness} ({source}, home {command.home})")
    return 1 if failed else 0


def main(arguments: list[str]) -> int:
    commands = read_commands()
    if not arguments or arguments == ["--help"] or arguments == ["-h"]:
        print_usage(commands)
        return 0 if arguments else 2
    command, rest = arguments[0], arguments[1:]
    if command in ("launch", "resolve"):
        if not rest:
            raise ConfigError(f"{command} requires a model name")
        invocation, _ = resolve(commands, rest[0], rest[1:])
        if command == "resolve":
            print(shlex.join(invocation))
            return 0
        try:
            os.execvp(invocation[0], invocation)
        except FileNotFoundError as error:
            raise ConfigError(
                f"harness executable {invocation[0]!r} was not found on PATH"
            ) from error
        raise AssertionError("execvp returned")
    if command == "default":
        return command_default(commands, rest)
    if command == "resolve-session":
        return command_resolve_session(rest)
    if command == "config":
        return command_config(commands, rest)
    if command == "doctor":
        return command_doctor(commands, rest)
    raise ConfigError(f"unknown command {command!r}")


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except ConfigError as error:
        print(f"agent-model: {error}", file=sys.stderr)
        raise SystemExit(2)
