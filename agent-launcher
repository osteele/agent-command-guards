#!/bin/bash
#
# Generic launcher that activates the command guards for one agent CLI.
#
# Invoked through a symlink named for the agent it launches (kimi, opencode,
# codex, omp).
# The symlink name selects the real binary to find and whether that agent needs
# the Zsh bridge; everything else is shared.

set -euo pipefail

SCRIPT_PATH="$(realpath "$0")"
LAUNCHER_DIR="$(dirname "$SCRIPT_PATH")"
NAME="$(basename "$0")"
DEFAULT_SHADOW_DIR="$LAUNCHER_DIR/shadows"
SHADOW_DIR="${AGENT_LAUNCHER_PREPEND_PATH:-$DEFAULT_SHADOW_DIR}"
SHELL_INIT_DIR="$LAUNCHER_DIR/launchers/shell-init"

if [[ "$NAME" == "agent-launcher" ]]; then
    printf 'Error: run %s through an agent-named symlink, not directly\n' \
        "$SCRIPT_PATH" >&2
    exit 2
fi

# Installers that place the real binary outside the directories a login shell
# puts on PATH. Consulted only after the PATH search comes up empty.
fallback_candidates() {
    case "$NAME" in
        kimi) printf '%s\n' "$HOME/.kimi-code/bin/kimi" ;;
        opencode) printf '%s\n' "/opt/homebrew/bin/opencode" ;;
        codex) printf '%s\n' "/opt/homebrew/bin/codex" ;;
    esac
}

# Agents that re-source the user's Zsh configuration for their shell tool. That
# restores mise shims -- including a competing `uv` -- ahead of the shadows, so
# these need PATH restored after each startup file runs.
needs_shell_bridge() {
    case "$NAME" in
        opencode|codex) return 0 ;;
        *) return 1 ;;
    esac
}

# mise shims are symlinks to the mise binary itself, which decides at call
# time which real tool to exec. When no version is active for the tool it
# falls back to re-scanning PATH, which loops straight back into this
# launcher if the launcher is also first on PATH (as `omp` was: mise had no
# active oh-my-pi version, so its shim re-executed the launcher, which found
# the shim again, forever). `mise which` performs the same lookup as a fast,
# synchronous config read with no exec chain, so route shim candidates
# through it instead of trusting or running the shim directly.
MISE_BIN_REALPATH_CHECKED=0
MISE_BIN_REALPATH=""

mise_bin_realpath() {
    if [[ "$MISE_BIN_REALPATH_CHECKED" -eq 0 ]]; then
        MISE_BIN_REALPATH_CHECKED=1
        if command -v mise >/dev/null 2>&1; then
            MISE_BIN_REALPATH="$(realpath "$(command -v mise)" 2>/dev/null || true)"
        fi
    fi
    printf '%s\n' "$MISE_BIN_REALPATH"
}

resolve_via_mise() {
    local resolved real_resolved
    resolved="$(mise which "$NAME" 2>/dev/null || true)"
    [[ -n "$resolved" && -x "$resolved" ]] || return 1
    real_resolved="$(realpath "$resolved" 2>/dev/null || true)"
    [[ -n "$real_resolved" && "$real_resolved" != "$SCRIPT_PATH" ]] || return 1
    printf '%s\n' "$resolved"
}

find_real_binary() {
    local candidate real_candidate mise_bin resolved

    mise_bin="$(mise_bin_realpath)"

    while IFS= read -r candidate; do
        real_candidate="$(realpath "$candidate" 2>/dev/null || true)"
        [[ -n "$real_candidate" ]] || continue
        [[ "$real_candidate" == "$SCRIPT_PATH" ]] && continue

        if [[ -n "$mise_bin" && "$real_candidate" == "$mise_bin" ]]; then
            if resolved="$(resolve_via_mise)"; then
                printf '%s\n' "$resolved"
                return 0
            fi
            continue
        fi

        printf '%s\n' "$candidate"
        return 0
    done < <(which -a "$NAME" 2>/dev/null)

    while IFS= read -r candidate; do
        [[ -n "$candidate" && -x "$candidate" ]] || continue
        real_candidate="$(realpath "$candidate" 2>/dev/null || true)"
        if [[ -n "$real_candidate" && "$real_candidate" != "$SCRIPT_PATH" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done < <(fallback_candidates)

    printf 'Error: Could not find the real %s binary after %s\n' \
        "$NAME" "$SCRIPT_PATH" >&2
    return 1
}

prepend_path_once() {
    local directory="$1"
    local entry
    local updated="$directory"
    local IFS=':'

    for entry in $PATH; do
        if [[ -n "$entry" && "$entry" != "$directory" ]]; then
            updated="$updated:$entry"
        fi
    done
    PATH="$updated"
    export PATH
}

# The shadows moved from the repository root into shadows/ at this timestamp.
# Root symlinks left behind serve sessions that started before the move, so they
# are removable once the machine has booted since.
SHADOWS_MOVED_AT=1786909200

report_transitional_symlinks() {
    local present=() link
    for link in git ram-guard shadow_wrapper.py ssh scp rsync uv; do
        [[ -L "$LAUNCHER_DIR/$link" ]] && present+=("$link")
    done
    [[ ${#present[@]} -eq 0 ]] && return 0

    local booted
    # Absent on Linux, and absent from a minimal PATH; report without it.
    booted=$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\).*/\1/p' || true)

    if [[ -n "$booted" && "$booted" -gt "$SHADOWS_MOVED_AT" ]]; then
        printf 'WARN Transitional root symlinks are now removable (booted since the shadows/ move):\n'
        printf '       cd %s && rm %s\n' "$LAUNCHER_DIR" "${present[*]}"
    else
        printf 'OK   Transitional root symlinks serving pre-move sessions: %s\n' "${present[*]}"
    fi
}

doctor() {
    local failed=false
    local real_binary active

    printf '%s Launcher Health Check\n\n' "$NAME"
    printf 'OK   Launcher: %s\n' "$SCRIPT_PATH"

    if real_binary="$(find_real_binary)"; then
        printf 'OK   Real %s: %s\n' "$NAME" "$real_binary"
    else
        printf 'FAIL Real %s: not found\n' "$NAME"
        failed=true
    fi

    if [[ -x "$SHADOW_DIR/git" ]]; then
        printf 'OK   Git shadow: %s\n' "$SHADOW_DIR/git"
    else
        printf 'WARN Git shadow: %s/git is missing or not executable\n' "$SHADOW_DIR"
    fi

    if [[ -x "$SHADOW_DIR/uv" && -x "$SHADOW_DIR/with-limits" ]]; then
        printf 'OK   UV RAM guard: %s\n' "$SHADOW_DIR/uv"
    else
        printf 'WARN UV RAM guard is incomplete under %s\n' "$SHADOW_DIR"
    fi

    if needs_shell_bridge; then
        if [[ -f "$SHELL_INIT_DIR/.zshenv" ]]; then
            printf 'OK   Zsh bridge: %s\n' "$SHELL_INIT_DIR"
        else
            printf 'FAIL Zsh bridge: %s/.zshenv is missing\n' "$SHELL_INIT_DIR"
            failed=true
        fi
    else
        printf 'OK   Zsh bridge: not required by %s\n' "$NAME"
    fi

    report_transitional_symlinks

    active="$(command -v "$NAME" 2>/dev/null || true)"
    if [[ -n "$active" && "$(realpath "$active")" == "$SCRIPT_PATH" ]]; then
        printf 'OK   Launcher is first on PATH\n'
    else
        printf 'WARN Launcher is not first on PATH (found %s)\n' "${active:-nothing}"
    fi

    if $failed; then
        return 1
    fi
}

if [[ "${1:-}" == "wrapper" ]]; then
    case "${2:-}" in
        doctor)
            doctor
            exit $?
            ;;
        path)
            printf '%s\n' "$SCRIPT_PATH"
            exit 0
            ;;
    esac
fi

new_session_id() {
    if command -v uuidgen >/dev/null 2>&1; then
        uuidgen
    else
        printf 'agent-%s-%s\n' "$$" "$(date +%s)"
    fi
}

# The session id an explicit resume argument names, or non-zero when the
# command line names none. Each agent spells the flag differently, and the
# value shapes differ too: kimi prefixes a uuid with `session_` (its own
# "To resume this session:" hint prints `kimi -r session_<uuid>`), opencode
# uses `ses_` followed by an opaque token, omp and codex use a bare uuid.
#
# Matched against a shape rather than accepted verbatim, so that `--last`, a
# path, or a session *name* does not become an address.
resume_id_from_args() {
    local flags name value
    case "$NAME" in
        kimi)     flags=" -r --resume -S --session " ;;
        omp)      flags=" -r --resume " ;;
        codex)    flags=" resume " ;;
        opencode) flags=" -s --session " ;;
        agy)      flags=" --conversation " ;;
        *)        return 1 ;;
    esac
    local uuid='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'
    while [[ $# -gt 0 ]]; do
        name="$1"
        value=""
        if [[ "$name" == *=* ]]; then
            value="${name#*=}"
            name="${name%%=*}"
        fi
        if [[ "$flags" == *" $name "* ]]; then
            [[ -z "$value" ]] && value="${2:-}"
            if [[ "$value" =~ ^(session_)?${uuid}$ || "$value" =~ ^ses_[A-Za-z0-9]{10,}$ ]]; then
                printf '%s\n' "$value"
                return 0
            fi
        fi
        shift
    done
    return 1
}

REAL_BINARY="$(find_real_binary)"

# OMP's updater resolves `omp` from PATH to decide which installation it owns.
# Leave the launcher first for normal sessions, but make the resolved binary's
# directory win during an update. Otherwise OMP follows launchers/omp to this
# shared file and replaces the launcher itself with the downloaded OMP binary.
if [[ "$NAME" == "omp" && "${1:-}" == "update" ]]; then
    prepend_path_once "$(dirname "$REAL_BINARY")"
fi

# OMP counts an inherited provider key as being logged in: its provider list
# reports the provider as `logged in (env)` and every request bills at API rates.
# An env key also suppresses a stored OAuth credential unless one is explicitly
# selected, so authorizing the subscription does not by itself take effect. Claude
# Code gates a key it did not obtain itself behind an approval prompt; OMP has no
# such gate, and this machine loads keys from the keychain into every interactive
# shell.
#
# `OPENAI_API_KEY` was found set in every agent session on 2026-09-05, so OMP
# routed to `openai-codex` was billing per token exactly as Anthropic would have
# been. Z.AI is deliberately absent: its only available key bills the GLM coding
# plan, so a key there *is* the subscription.
#
# Set AGENT_LAUNCHER_KEEP_API_KEYS=1 to bill the API deliberately.
if [[ "$NAME" == "omp" && -z "${AGENT_LAUNCHER_KEEP_API_KEYS:-}" ]]; then
    unset ANTHROPIC_API_KEY
    unset OPENAI_API_KEY
fi

# Per-session identity, so agent-mail can address one of several sessions
# sharing a directory instead of broadcasting to all of them.
#
# Some agents launched here export no per-session id of their own: opencode
# exports only OPENCODE_PID and a per-workspace id, and kimi reads
# KIMI_SESSION_ID without ever setting it. OMP has a native conversation id,
# but exposes it only through its extension API rather than to MCP and tool
# subprocesses. Without an id minted here, sibling components can resolve one
# logical agent to different addresses.
#
# Unset the native ids first, and mint unconditionally. Both are about nesting:
# an agent launched from inside another agent's shell inherits that parent's
# CLAUDE_CODE_SESSION_ID (verified) and would otherwise answer to the parent's
# identity, which is worse than broadcasting -- work would be attributed to one
# specific wrong session.
unset CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID
# A resumed session is the same session. Minting a fresh id for it would give
# it a new address on every resume, and downstream a new agent-mail name, so
# prefer the id named on the command line when there is one.
#
# Only an explicit id counts. `--continue` and the interactive pickers name no
# session, and each agent settles on one only after this launcher has exec'd,
# so at this point there is nothing to read: those still mint. Reading the
# agent's own session store instead was rejected -- kimi writes its index
# entry seconds AFTER its MCP servers have already registered, so the store is
# empty exactly when this needs an answer.
if resumed_id="$(resume_id_from_args "$@")"; then
    AGENT_SESSION_ID="$resumed_id"
else
    AGENT_SESSION_ID="$(new_session_id)"
fi
export AGENT_SESSION_ID
# Names the process this id was minted for. `exec` below replaces this shell,
# so $$ is the agent's own pid. Unsetting above protects an agent this launcher
# starts; the marker protects consumers of an agent started WITHOUT it, which
# inherits our AGENT_SESSION_ID from the environment and is otherwise
# indistinguishable from having been minted its own. A consumer that knows its
# host agent's pid rejects an id whose marker names a different process.
AGENT_SESSION_PID=$$
export AGENT_SESSION_PID

if [[ -x "$SHADOW_DIR/git" ]]; then
    prepend_path_once "$SHADOW_DIR"
    export AGENT_COMMAND_GUARDS_ACTIVE=1
    export AGENT_COMMAND_GUARDS_DIR="$SHADOW_DIR"
    if needs_shell_bridge && [[ -f "$SHELL_INIT_DIR/.zshenv" ]]; then
        if [[ "${ZDOTDIR:-}" != "$SHELL_INIT_DIR" ]]; then
            export AGENT_LAUNCHER_ORIGINAL_ZDOTDIR="${ZDOTDIR:-$HOME}"
        fi
        export ZDOTDIR="$SHELL_INIT_DIR"
    fi
fi

# Codex 0.153.1 can fan skill discovery out to hundreds of simultaneous file
# reads. On macOS, processes launched through a GUI can inherit a soft limit of
# 256 even when interactive shells usually raise it, causing valid skills to be
# skipped nondeterministically with EMFILE. Raise only Codex's soft limit; the
# kernel-enforced hard limit remains unchanged.
if [[ "$NAME" == "codex" ]]; then
    SOFT_NOFILE="$(ulimit -Sn 2>/dev/null || true)"
    if [[ "$SOFT_NOFILE" =~ ^[0-9]+$ && "$SOFT_NOFILE" -lt 65536 ]]; then
        HARD_NOFILE="$(ulimit -Hn 2>/dev/null || true)"
        TARGET_NOFILE=65536
        if [[ "$HARD_NOFILE" =~ ^[0-9]+$ && "$HARD_NOFILE" -lt "$TARGET_NOFILE" ]]; then
            TARGET_NOFILE="$HARD_NOFILE"
        fi
        if [[ "$TARGET_NOFILE" -gt "$SOFT_NOFILE" ]] &&
            ! ulimit -Sn "$TARGET_NOFILE"; then
            printf 'WARN Could not raise Codex open-file limit above %s\n' \
                "$SOFT_NOFILE" >&2
        fi
    fi
fi

# Reduced CPU priority for the agent and everything it spawns (children
# inherit niceness). `nice` only arbitrates contention: on idle cores the agent
# runs at full speed, and under load the user's interactive work wins. `nice`
# execs the target in place, so $$ and AGENT_SESSION_PID still name the agent.
NICENESS="${AGENT_LAUNCHER_NICE:-5}"
exec nice -n "$NICENESS" "$REAL_BINARY" "$@"
